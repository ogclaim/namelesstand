local GUN_ALIASES = {}
GUN_ALIASES["uzi"] = {"uzi", "smg"}
GUN_ALIASES["rev"] = {"revolver", "rev"}
GUN_ALIASES["db"] = {"double-barrel", "doublebarrel", "db"}
GUN_ALIASES["sg"] = {"shotgun", "sg"}
GUN_ALIASES["tacticalsg"] = {"tacticalshotgun", "tacticalsg", "tactical"}
GUN_ALIASES["silencer"] = {"silencer"}

F.CollectGuns = function()
    local guns = {}
    local addTool = function(tool)
        if not tool then return end
        if not tool:IsA("Tool") then return end
        local nm = tool.Name:lower()
        if nm:find("knife") or nm:find("combat") then return end
        guns[#guns + 1] = tool
    end
    local char = LocalPlayer and LocalPlayer.Character
    local bag = LocalPlayer and LocalPlayer:FindFirstChild("Backpack")
    if char then
        for _, child in ipairs(char:GetChildren()) do
            addTool(child)
        end
    end
    if bag then
        for _, child in ipairs(bag:GetChildren()) do
            addTool(child)
        end
    end
    return guns
end

F.FindGunByKey = function(key)
    local aliases = GUN_ALIASES[lower(key)]
    if not aliases then return nil end
    for _, tool in ipairs(F.CollectGuns() or {}) do
        local n = tool.Name:lower()
        for _, a in ipairs(aliases) do
            if n == a or n:find(a, 1, true) then return tool end
        end
    end
    return nil
end

F.SelectGun = function(key)
    key = lower(key)
    if not GUN_ALIASES[key] then
        F.BotChat("Selected gun = " .. key .. " not found!")
        return false
    end
    SelectedGunKey = key
    local tool = F.FindGunByKey(key)
    if tool then
        UseGun = true
        pcall(function() tool.Parent = LocalPlayer.Character end)
        LockedGunTool = tool
        F.BotChat("Selected gun = " .. key .. " found!")
        return true
    end
    F.BotChat("Selected gun = " .. key .. " not found!")
    return false
end

F.EquipGun = function()
    if SelectedGunKey then
        local t = F.FindGunByKey(SelectedGunKey)
        if t then pcall(function() t.Parent = LocalPlayer.Character end) LockedGunTool = t return t end
    end
    local guns = F.CollectGuns()
    if guns[1] then
        pcall(function() guns[1].Parent = LocalPlayer.Character end)
        LockedGunTool = guns[1]
        return guns[1]
    end
    return nil
end

