            local count, tool = getToolAmmoCount()
            if typeof(count) == "number" then
                -- detect reload: ammo went from 0 (or low) up after reload
                if lastAmmo ~= nil and lastAmmo <= AMMO_LOW_THRESHOLD and count > lastAmmo then
                    ReloadCount = ReloadCount + 1
                    if ReloadCount >= 4 then
                        ReloadCount = 0
                        local key = gunKeyFromTool(tool) or SelectedGuns[1]
                        local allowed = false
                        if key then
                            for _, s in ipairs(SelectedGuns) do
                                if s == key then allowed = true break end
                            end
                        end
                        if not allowed then key = SelectedGuns[1] allowed = key ~= nil end
                        if allowed then
                            task.spawn(function() doAmmoBuyOnce(key) end)
                        end
                    end
                end
                lastAmmo = count
            end
        end
    end
end)

local function equipSelectedGuns()
    ensureGuns()
    local bag = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = getHum(char)
    if not hum then return nil end
    -- Equip first available selected gun (Roblox only shows one; we cycle if needed)
    for _, key in ipairs(SelectedGuns) do
        local t = findTool(key, char) or findTool(key, bag)
        if t then
            pcall(function() hum:EquipTool(t) end)
            return t
        end
    end
    -- any gun
    if bag then
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("Handle") and not t.Name:lower():find("knife") then
                pcall(function() hum:EquipTool(t) end)
                return t
            end
        end
    end
    return nil
end

local function equipKnife()
    local bag = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    local hum = getHum(char)
    if not hum then return nil end
    for _, parent in ipairs({ char, bag }) do
        if parent then
            for _, t in ipairs(parent:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("knife") then
                    pcall(function() hum:EquipTool(t) end)
                    return t
                end
            end
        end
    end
    return nil
end

local function tryReload()
    if not AutoReload then return end
    local me = refreshMainEvent()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or tool.Name:lower():find("knife") then return end
    -- ammo empty or low
    local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AMMO")
    local need = true
    if ammo and typeof(ammo.Value) == "number" then
        need = ammo.Value <= 0
    end
    if not need then return end
    if me then
        pcall(function() me:FireServer("Reload") end)
        pcall(function() me:FireServer("Reload", tool) end)
    end
    pcall(function()
        local r = tool:FindFirstChild("Reload") or tool:FindFirstChild("Remote")
        if r and r:IsA("RemoteEvent") then r:FireServer() end
    end)
end

