-- ==== FORCE RESET (larptic PerformReset - exact) ====
-- The ONLY reset the game accepts: ResetButtonCallback set + Kill signal via
-- replicatesignal. Fallback: ChangeState Dead + Health 0.
local RESET_GRACE = 3
local function koTruthy(v)
    if type(v) == "boolean" then return v end
    if v == nil then return false end
    if type(v) == "number" then return v ~= 0 end
    if typeof and typeof(v) == "Vector3" then return v.Magnitude > 0.01 end
    return true
end
local function forceReset()
    pcall(function() StarterGui:SetCore("ResetButtonCallback", true) end)
    pcall(function() replicatesignal(LocalPlayer.Kill) end)
    pcall(function()
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Dead)
            hum.Health = 0
        end
    end)
end
-- ==== OWNER AUTO FORCE-RESET ON KNOCK ====
-- A knock is exactly what enemy knifegangers wait for: a free stomp/grab. The
-- instant OUR K.O flag flips while we are the owner, force-reset so there is
-- no body left to stomp. (Owner only - alts manage their own loops.)
do
    local g2 = (getgenv and getgenv()) or _G
    if g2.STAND_KO_RESET_CONN then
        pcall(function() g2.STAND_KO_RESET_CONN:Disconnect() end)
        g2.STAND_KO_RESET_CONN = nil
    end
    if isOwner then
        local wasKO = false
        g2.STAND_KO_RESET_CONN = RunService.Heartbeat:Connect(function()
            if copyIsStale() then return end
            local char = localPlayer.Character
            local be = char and char:FindFirstChild("BodyEffects")
            local ko = be and be:FindFirstChild("K.O") and be["K.O"].Value and true or false
            if ko and not wasKO then
                print("[STAND] knocked - force resetting instantly")
                forceReset()
            end
            wasKO = ko
        end)
    end
end
-- ==== FLASHBACK - respawn where you died (larptic, exact) ====
-- When health drops to <= 10 the current CFrame is saved; on respawn (health
-- back above 10 on the new character) we teleport back to that spot with a tiny
-- sinusoidal nudge so the server never sees us freeze in place. Auto-on for
-- owner AND alts; per-process latch stops duplicates on re-inject.
local g = (getgenv and getgenv()) or _G
g.flashback = g.flashback or {}
if g.flashback.conn then
    pcall(function() g.flashback.conn:Disconnect() end)
    g.flashback.conn = nil
end
g.flashback.settings = { enabled = true }
local fbLastCF = nil
g.flashback.conn = RunService.Heartbeat:Connect(function()
    if not g.flashback.settings.enabled then return end
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if hum.Health <= 10 and not fbLastCF then
        fbLastCF = hrp.CFrame
    elseif hum.Health > 10 and fbLastCF then
        pcall(function()
            hrp.CFrame = fbLastCF + Vector3.new(math.sin(tick()) * 0.001, 0, math.cos(tick()) * 0.001)
        end)
        print("[STAND-FLASHBACK] respawned at death spot")
        fbLastCF = nil
    end
end)
local function partOfAnotherPlayer(part)
    if not part or not part.Parent then return false end
    local p = part.Parent
    if p:IsA("Tool") then p = p.Parent end
    if p and p:IsA("Model") then
        local owner = Players:GetPlayerFromCharacter(p)
        if owner and owner ~= localPlayer then return true end
    end
    return false
end
-- True while this alt is actively attached to another player (glued/carrying) -
-- being picked up by an enemy is exactly when we WANT to reset.
local function altHeld()
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    if not root then return false end
    for _, w in ipairs(char:GetDescendants()) do
        if w:IsA("WeldConstraint") then
            local p0, p1 = w.Part0, w.Part1
            if (p0 == root and partOfAnotherPlayer(p1)) or (p1 == root and partOfAnotherPlayer(p0)) then
                return true
            end
        end
    end
    return false
end
-- Reset loop: resets when the alt is picked up by another player (immediately)
-- or has been knocked down (health zeroed / K.O flag) for RESET_GRACE consecutive
-- half-second ticks. Never during an attack. Reset spam is blocked by a cooldown.
task.spawn(function()
    if isOwner then return end
    local wasDowned = false
    local downFrames = 0
    local lastResetTime = 0
    while true do
        task.wait(0.5)
        pcall(function()
            if tick() - lastResetTime < 3 then return end
            local char = localPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            -- HARD GUARD: if ANY attack connection is alive, don't reset
            if glueConn or swingConn or forceHitConn or bringConn or followConn then
                wasDowned = false
                downFrames = 0
                return
            end
            if altMode ~= "none" then
                wasDowned = false
                downFrames = 0
                return
            end
            -- Picked up by another player -> reset to break free
            if altHeld() then
                print("[STAND-RESET] alt picked up - force resetting")
                forceReset()
                lastResetTime = tick()
                wasDowned = false
                downFrames = 0
                return
            end
            -- Knocked down: health zeroed OR the K.O flag is set
            local downed = hum.Health <= 0
            local be = char:FindFirstChild("BodyEffects")
            if be and be:FindFirstChild("K.O") and koTruthy(be["K.O"].Value) then
                downed = true
            end
            if downed and not wasDowned then
                wasDowned = true
                downFrames = 1
            elseif downed and wasDowned then
                downFrames = downFrames + 1
                if downFrames >= RESET_GRACE then
                    print("[STAND-RESET] alt knocked down - force resetting")
                    forceReset()
                    lastResetTime = tick()
                    wasDowned = false
                    downFrames = 0
                end
            else
                wasDowned = false
                downFrames = 0
            end
        end)
    end
end)
-- ==== COMMAND PARSING ====
local function parseCommand(msg)
    if not msg then return nil end
    local first = msg:sub(1,1)
    if first ~= "," and first ~= "." then return nil end
    local args = {}
    for w in msg:sub(2):gmatch("%S+") do table.insert(args, w) end
    return (args[1] or ""):lower(), args
end
