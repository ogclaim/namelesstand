end
-- ==== FILE ORDER CHANNEL (chat-proof) ====
-- Owner writes each command to a shared file; every alt polls it. Commands reach
-- even shadow-muted accounts whose chat the game never delivers. Format per
-- line: "<n>|<unixTime>|<raw msg>". Orders older than 120s are ignored so fresh
-- alt processes never replay stale orders from the file.
local ORDERS_FILE = "stand_orders.txt"
local WHITELIST_FILE = "stand_whitelist.txt"
local function orderIO()
    local env = (getgenv and getgenv()) or _G
    local wf = env.writefile or _G.writefile
    local rf = env.readfile or _G.readfile
    local fi = env.isfile or _G.isfile
    if type(wf) == "function" and type(rf) == "function" and type(fi) == "function" then
        return wf, rf, fi
    end
    return nil
end
local function writeOrder(msg, authorId, force)
    local wf, rf, fi = orderIO()
    if not wf then return end
    local shared = (getgenv and getgenv()) or _G
    -- NO dynamic owner auto-registration: that let any order-writer promote
    -- itself (or get polluted) into owner state across re-injections.
    -- Ownership is the hardcoded OWNER_USERIDS list only.
    -- Dedupe duplicate writes (multiple chat hooks can fire for one message).
    -- Only a repeat within the SAME second is treated as a hook double-fire;
    -- re-typing the same order later always writes again.
    if shared.STAND_WRITE_LAST == msg
        and type(shared.STAND_WRITE_T) == "number"
        and os.time() == shared.STAND_WRITE_T then
        return
    end
    shared.STAND_WRITE_LAST = msg
    shared.STAND_WRITE_T = os.time()
    local n = (shared.STAND_ORDER_N or 0) + 1
    shared.STAND_ORDER_N = n
    local author = authorId or ""
    pcall(function()
        local lines = {}
        if fi(ORDERS_FILE) then
            local ok, data = pcall(rf, ORDERS_FILE)
            if ok and data then
                for line in data:gmatch("[^\r\n]+") do
                    if #line > 0 then table.insert(lines, line) end
                end
            end
        end
        -- Echo guard: applies ONLY to fleet echo writes (force=false - the
        -- typist's OWN window always writes with force=true, so commands you
        -- type have NO 30s limit). Blocks fleet copies of one command.
        local now = os.time()
        if not force then
            for i = #lines, 1, -1 do
                local n2, t2, a2, m2 = lines[i]:match("^(%d+)|(%d+)|(%d+)|(.*)$")
                if m2 == msg and tonumber(a2) == tonumber(author)
                    and tonumber(t2) and now - tonumber(t2) < 30 then
                    return
                end
            end
        end
        local line = n .. "|" .. now .. "|" .. author .. "|" .. msg
        -- Append-only when the executor supports it: no read-modify-write race
        -- between fleet windows, so an order can never be lost to two writers.
        local af = ((getgenv and getgenv()) or _G).appendfile or _G.appendfile
        if type(af) == "function" and #lines <= 40 then
            local wrote = pcall(af, ORDERS_FILE, line .. "\n")
            if wrote then
                print("[STAND-ORDER] wrote:", msg)
                return
            end
        end
        -- Fallback: housekeeping trim (rare) or no appendfile - rewrite.
        if #lines > 40 then
            local keep = {}
            for i = #lines - 19, #lines do keep[#keep + 1] = lines[i] end
            lines = keep
        end
        table.insert(lines, line)
        wf(ORDERS_FILE, table.concat(lines, "\n"))
        print("[STAND-ORDER] wrote:", msg)
    end)
end
-- ==== WHITELIST FILE CHANNEL ====
-- getgenv() is per-executor. The OWNER's whitelist table lives in the owner's
-- executor only; alts (separate Roblox processes) never see it. To make a
-- whitelist UID work across all alts we mirror the table into a shared file
-- and have every client re-read it on each poll iteration (0.3s).
local function writeWhitelist()
    local wf, rf, fi = orderIO()
    if not wf then return end
    local shared = (getgenv and getgenv()) or _G
    shared.STAND_OWNER_UIDS = shared.STAND_OWNER_UIDS or {}
    local uids = {}
    for uid in pairs(shared.STAND_OWNER_UIDS) do
        table.insert(uids, uid)
    end
    table.sort(uids)
    pcall(function() wf(WHITELIST_FILE, table.concat(uids, "\n")) end)
end
local function readWhitelist()
    local wf, rf, fi = orderIO()
    if not rf or not fi then return end
    if not fi(WHITELIST_FILE) then return end
    pcall(function()
        local data = rf(WHITELIST_FILE)
        if not data then return end
        local shared = (getgenv and getgenv()) or _G
        shared.STAND_OWNER_UIDS = shared.STAND_OWNER_UIDS or {}
        for line in data:gmatch("[^\r\n]+") do
            local uid = tonumber(line:match("^%s*(%d+)%s*$"))
            if uid then
                shared.STAND_OWNER_UIDS[tostring(uid)] = true
            end
        end
    end)
end
