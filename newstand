-- Kill positions
function F.GetKillCF(tRoot)
    if not tRoot then return nil end
    local dist = KillDistance or 10
    local pos = KillPosition or "Top"
    local look = tRoot.CFrame.LookVector
    local right = tRoot.CFrame.RightVector
    local origin = tRoot.Position
    local off
    if pos == "Top" then off = Vector3.new(0, dist, 0)
    elseif pos == "Bottom" then off = Vector3.new(0, -dist, 0)
    elseif pos == "Front" then off = look * dist
    elseif pos == "Back" then off = -look * dist
    elseif pos == "Left" then off = -right * dist
    elseif pos == "Right" then off = right * dist
    else off = Vector3.new(0, dist, 0)
    end
    local p = origin + off
    return CFrame.new(p, origin)
end

function F.DoStomp(target)
    local tc = target and target.Character
    if not tc then return end
    local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("HumanoidRootPart")
    local r = F.root()
    if not ut or not r then return end
    r.CFrame = CFrame.new(ut.Position + Vector3.new(0, 3.4, 0))
    if MainEvent then
        for _ = 1, 5 do pcall(function() MainEvent:FireServer("Stomp") end) end
    end
end

function F.StartKill(targets, auto)
    if F.IsControllerClient() then return end
    if type(targets) ~= "table" then targets = { targets } end
    if #targets == 0 then return end
    F.StopAll()
    TargetList = targets
    TargetIndex = 1
    TargetPlayer = targets[1]
    CurrentAction = auto and "autokill" or "kill"
    GlueTargetPlayer = TargetPlayer
    if UseGun then
        F.StartGlue("gun", TargetPlayer)
    else
        F.StartGlue("knife", TargetPlayer)
    end
    local voidPhase, voidUntil = "surface", 0
    KillAttackConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then return end
        local t = TargetList[TargetIndex]
        if not t or not t.Parent then
            if CurrentAction == "autokill" then return end
            F.StopAll()
            return
        end
        if not t.Character then return end
        local r = F.root()
        local tr = t.Character:FindFirstChild("HumanoidRootPart")
        if not r or not tr then return end

        if F.isKnocked(t.Character) then
            F.DoStomp(t)
            WaitFFUntil = tick() + WaitFFDelay
            if CurrentAction == "kill" then
                F.StopAll()
                return
            end
            -- autokill: wait for respawn/FF clear
            return
        end

        if tick() < (WaitFFUntil or 0) then return end
        if not F.isFullyAlive(t) then return end

        if KillMethod == "spamvoid" then
            local now = tick()
            if voidPhase == "surface" then
                local cf = F.GetKillCF(tr)
                if cf then r.CFrame = cf end
                if UseGun then F.EquipGun() F.FireForceHit(t) F.TryReload()
                else local k = F.EquipKnife() if k then pcall(function() k:Activate() end) end end
                voidPhase = "void"
                voidUntil = now + (UseGun and GunSpamVoidIn or KnifeSpamVoidIn)
            else
                r.CFrame = CFrame.new(r.Position.X, -500, r.Position.Z)
                if now >= voidUntil then
                    voidPhase = "surface"
                    voidUntil = now + (UseGun and GunSpamVoidOut or KnifeSpamVoidOut)
                end
            end
        else
            -- orbit
            local angle = tick() * (OrbitSpeed or 30)
            local dist = GunOrbitDist or 10
            local o = tr.Position + Vector3.new(math.cos(angle) * dist, OrbitHeight or 3, math.sin(angle) * dist)
            r.CFrame = CFrame.new(o, tr.Position)
            if UseGun then
                F.EquipGun()
                F.FireForceHit(t)
                F.TryReload()
            else
                local k = F.EquipKnife()
                if k then pcall(function() k:Activate() end) end
            end
        end
    end)
end

function F.StartKillAura()
    if KillAuraConnection then KillAuraConnection:Disconnect() end
    KillAuraEnabled = true
    local last = 0
    KillAuraConnection = RunService.Heartbeat:Connect(function()
        if not KillAuraEnabled then return end
        local r = F.root()
        if not r then return end
        F.EquipGun()
        local best, bd = nil, (KillAuraRange or 80) + 0.01
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and not F.isWhitelisted(p) and F.isFullyAlive(p) then
                local h = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - r.Position).Magnitude
                    if d < bd and d <= (KillAuraRange or 80) then
                        if not F.HasWallBetween(r.Position, h.Position) then
                            best, bd = p, d
                        end
                    end
                end
            end
        end
        if best and tick() - last > (KillAuraDelay or 0.06) then
            if F.FireForceHit(best) then last = tick() end
        end
    end)
end

function F.StopKillAura()
    KillAuraEnabled = false
    if KillAuraConnection then KillAuraConnection:Disconnect() KillAuraConnection = nil end
end

function F.SetOptMode(on)
    OptMode = on and true or false
    if not OptMode then return end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function()
        local L = game:GetService("Lighting")
        L.GlobalShadows = false
    end)
    task.spawn(function()
        while OptMode do
            local r = F.root()
            if r then
                local origin, range2 = r.Position, (OptCullRange or 50)^2
                for _, child in ipairs(workspace:GetChildren()) do
                    local isChar = false
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr.Character == child then isChar = true break end
                    end
                    if not isChar and not child:IsA("Terrain") then
                        local pp = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                        if pp then
                            local d2 = (pp.Position - origin).Magnitude
                            local hide = d2 * d2 > range2
                            if child:IsA("BasePart") then
                                child.LocalTransparencyModifier = hide and 1 or 0
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

function F.FindPlayer(name)
    if not name then return nil end
    name = lower(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or p.DisplayName:lower() == name then return p end
        if p.Name:lower():sub(1, #name) == name then return p end
    end
    return nil
end

function F.ParseTargets(args, startIdx)
    local out = {}
    for i = startIdx, #args do
        local p = F.FindPlayer(args[i])
        if p then out[#out + 1] = p end
    end
    return out
end

function F.OnChatted(player, message)
    if not F.IsOwner(player) then return end
    if F.IsControllerClient() then return end -- controller does not listen to self for bot actions when same account
    -- stands execute; if controller is separate they chat and stands hear
    message = lower(message):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    if message:sub(1, #PREFIX) ~= PREFIX then return end
    local body = message:sub(#PREFIX + 1)
    local args = {}
    for w in body:gmatch("%S+") do args[#args + 1] = w end
    local cmd = args[1]
    if not cmd then return end

    if cmd == "stop" or cmd == "idle" then
        F.StopAll()
        F.StopKillAura()
    elseif cmd == "return" or cmd == "summon" or cmd == "follow" or cmd == "come" then
        F.StopProtectOwner()
        F.StartFollow()
    elseif cmd == "around" then
        F.StartAround()
    elseif cmd == "orbit" then
        local a2 = args[2] and lower(args[2]) or ""
        local n = tonumber(args[2])
        if n == 2 or a2 == "2" then
            F.StartControllerOrbit(2)
        elseif n == 3 or a2 == "3" then
            F.StartControllerOrbit(3)
        elseif n == 1 or a2 == "1" or a2 == "" then
            -- !orbit or !orbit 1 = horizontal controller orbit
            F.StartControllerOrbit(1)
        elseif a2 == "top" or a2 == "bottom" or a2 == "back" or a2 == "front" or a2 == "left" or a2 == "right" then
            KillPosition = a2:sub(1,1):upper() .. a2:sub(2)
            KillMethod = "orbit"
            OrbitEnabled = true
        else
            F.StartControllerOrbit(1)
        end
    elseif cmd == "orbitkill" then
        KillMethod = "orbit"
        OrbitEnabled = true
    elseif cmd == "flymode" or cmd == "fly" then
        local m = args[2] and lower(args[2]) or ""
        local map = { hover = "Hover", glide = "Glide", fly = "Fly", heaven = "Heaven", gogo = "gogo" }
        if map[m] then FlyMode = map[m] end
    elseif cmd == "spinbot" or cmd == "spin" then
        local n = tonumber(args[2])
        if args[2] == "off" then
            SpinbotEnabled = false
        elseif n then
            SpinbotSpeed = math.clamp(n, 1, 200)
            SpinbotEnabled = true
        else
            SpinbotEnabled = not SpinbotEnabled
        end
    elseif cmd == "gunspamkill" or cmd == "gsk" then
        UseGun = true
        KillMethod = "spamvoid"
    elseif cmd == "knifespamkill" or cmd == "ksk" then
        UseGun = false
        KillMethod = "spamvoid"
    elseif cmd == "kill" or cmd == "k" then
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, false) end
    elseif cmd == "autokill" or cmd == "ak" or cmd == "a" then
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "aorbit" then
        KillMethod = "orbit"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "agsk" then
        UseGun = true
        KillMethod = "spamvoid"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "aksk" then
        UseGun = false
        KillMethod = "spamvoid"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "ka" or cmd == "killaura" then
        local n = tonumber(args[2])
        if n then KillAuraRange = math.clamp(n, 5, 300) end
        if args[2] == "off" then F.StopKillAura()
        else F.StartKillAura() end
    elseif cmd == "opt" or cmd == "optimize" then
        if args[2] == "off" then OptMode = false
        else F.SetOptMode(true) end
    elseif cmd == "powner" or cmd == "protectowner" then
        F.StartProtectOwner()
    elseif cmd == "unpowner" or cmd == "unprotectowner" then
        F.StopProtectOwner()
    elseif cmd == "rapid" or cmd == "rapidfire" then
        if args[2] == "off" then RapidFireEnabled = false
        else RapidFireEnabled = true end
    elseif cmd == "transfer" then
        local p = F.FindPlayer(args[2])
        if p then
            ControllerName = p.Name
            ExtraOwners = {}
            Whitelist[p.Name:lower()] = true
            F.BotChat("controller -> " .. p.Name)
        end
    elseif cmd == "whitelist" or cmd == "wl" then
        local p = F.FindPlayer(args[2])
        if p then
            Whitelist[p.Name:lower()] = true
            F.BotChat("wl " .. p.Name)
        end
    elseif cmd == "ghold" or cmd == "hold" then
        HoldMode = "gun"
        UseGun = true
    elseif cmd == "khold" then
        HoldMode = "knife"
        UseGun = false
    elseif cmd == "uzi" or cmd == "rev" or cmd == "db" or cmd == "sg"
        or cmd == "tacticalsg" or cmd == "silencer" then
        F.SelectGun(cmd)
    elseif cmd == "gun" then UseGun = true
    elseif cmd == "knife" then UseGun = false
    elseif cmd == "blackscreen" or cmd == "bscreen" then
        if args[2] == "off" then F.SetBlackScreen(false)
        elseif args[2] == "on" then F.SetBlackScreen(true)
        else F.SetBlackScreen(BlackScreenGui == nil) end
    end
end

