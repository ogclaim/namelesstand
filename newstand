        { ox = -1, oz = 0 },  -- 1: left lane
        { ox = 1,  oz = 0 },  -- 2: right lane
        { ox = 0,  oz = 1 },  -- 3: front lane
        { ox = 0,  oz = -1 }, -- 4: back lane
        { ox = -2, oz = 0 },  -- 5: second-row far left
        { ox = 2,  oz = 0 },  -- 6: second-row far right
        { ox = 0,  oz = 2 },  -- 7: second-row far front
        { ox = 0,  oz = -2 }, -- 8: second-row far back
    }
    local slot = SLOTS[rank] or { ox = 0, oz = -2 }
    local lastWd = 0
    local anchorWarned = false
    -- anchor velocity tracking for predictive gluing
    local lastAnchorPos = nil
    local lastAnchorTick = tick()
    local anchorVel = Vector3.zero
    surroundConn = RunService.Heartbeat:Connect(function()
        if copyIsStale() then stopAttack() return end
        local owner = Players:GetPlayerByUserId(anchorUid) or Players:GetPlayerByUserId(OWNER_USERIDS[1])
        local oChar = owner and owner.Character
        local oRoot = oChar and (oChar:FindFirstChild("HumanoidRootPart") or oChar:FindFirstChild("Torso"))
        if not oRoot then
            if not anchorWarned then
                anchorWarned = true
                warn("[STAND-SURROUND] anchor character not found (uid " .. tostring(anchorUid) .. ") - cannot guard")
            end
            return
        end
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if not char or not root then return end
        -- PREDICTIVE GLUE: replication lags ~100ms behind your REAL position,
        -- which reads as trailing at sprint speed. Lead the formation by the
        -- anchor's measured velocity (clamped) so the box stays welded on at
        -- any velocity.
        local nowA = tick()
        if lastAnchorPos and nowA > lastAnchorTick then
            local rawVel = (oRoot.Position - lastAnchorPos) / (nowA - lastAnchorTick)
            if rawVel.Magnitude > 150 then
                rawVel = rawVel.Unit * 150
            end
            anchorVel = rawVel
        end
        lastAnchorPos = oRoot.Position
        lastAnchorTick = nowA
        local anchorPos = oRoot.Position + anchorVel * 0.12
        local offA = anchorPos - oRoot.Position
        if offA.Magnitude > 20 then
            anchorPos = oRoot.Position + offA.Unit * 20
        end
        -- formation rotates with the anchor's facing
        local look = oRoot.CFrame.LookVector
        look = Vector3.new(look.X, 0, look.Z)
        local mag = look.Magnitude
        if mag < 0.01 then look = Vector3.new(0, 0, 1) else look = look / mag end
        local right = Vector3.new(-look.Z, 0, look.X)
        local spot = anchorPos + look * (slot.oz * SURROUND_DISTANCE) + right * (slot.ox * SURROUND_DISTANCE)
        local outward = Vector3.new(slot.ox * right.X + slot.oz * look.X, 0, slot.ox * right.Z + slot.oz * look.Z)
        pcall(function() root:SetNetworkOwner(localPlayer) end)
        -- PivotTo in its OWN pcall: a failed ownership/velocity call must never
        -- eat the position set (that was the stand-still-and-swing bug)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root:PivotTo(CFrame.lookAt(spot, spot + outward))
        end)
        -- heartbeat diagnostic: proves the loop is alive and glued
        if tick() - lastWd > 5 then
            lastWd = tick()
            print(("[STAND-SURROUND] alive - %.1f studs from anchor"):format((oRoot.Position - root.Position).Magnitude))
        end
        local knife = equipKnife()
        if knife then
            if crewAltNearby(10) then shrinkHitbox() else expandHitbox() end
            pcall(function() knife:Activate() end)
        end
    end)
end
