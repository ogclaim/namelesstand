            local oRoot = oChar and oChar:FindFirstChild("HumanoidRootPart")
            if not oRoot then return end
            local oCF = oRoot.CFrame
            local oLook = oCF.LookVector
            local oRight = oCF.RightVector
            local behind = -oLook
            -- Spread alts evenly in a horizontal line behind the owner
            -- (handles any number of alts without overlap)
            local sideSpread = 8
            local total = math.max(1, totalAlts)
            local centerOffset = -(total - 1) * sideSpread / 2
            local sideOffset = centerOffset + (altIndex - 1) * sideSpread
            local rowBack = math.floor((altIndex - 1) / 3) * 3
            local hover = math.sin((tick() - hoverStart) * 2.5) * 0.5
            local targetPos = oRoot.Position + behind * (5 + rowBack) + oRight * sideOffset + Vector3.new(0, 1.5 + hover, 0)
            pcall(function()
                r:SetNetworkOwner(localPlayer)
            end)
            pcall(function()
                r.AssemblyLinearVelocity = Vector3.zero
                r.CFrame = CFrame.new(targetPos, targetPos + oLook)
            end)
            h.WalkSpeed = 0
            h.JumpPower = 0
            if followModeTrack then
                followModeTrack.TimePosition = 3.5
                followModeTrack:AdjustSpeed(0)
            end
        end, function() end)
    end)
end
