local function stopAttack()
    if altEmoteTrack then
        pcall(function() altEmoteTrack:Stop() end)
        altEmoteTrack = nil
    end
    clearGlue()
    if swingConn then swingConn:Disconnect() swingConn = nil end
    if forceHitConn then forceHitConn:Disconnect() forceHitConn = nil end
    if skyConn then skyConn:Disconnect() skyConn = nil end
    if surroundConn then surroundConn:Disconnect() surroundConn = nil end
    if bringConn then bringConn:Disconnect() bringConn = nil end
    -- Cancel a running goaway void-pin (any new order takes priority)
    local sh0 = (getgenv and getgenv()) or _G
    if sh0.STAND_GOAWAY_ON then
        sh0.STAND_GOAWAY_ON = false
        sh0.STAND_GOAWAY_GEN = (sh0.STAND_GOAWAY_GEN or 0) + 1
        if sh0.STAND_GOAWAY_CONN then pcall(function() sh0.STAND_GOAWAY_CONN:Disconnect() end) sh0.STAND_GOAWAY_CONN = nil end
        pcall(function() workspace.FallenPartsDestroyHeight = -500 end)
    end
    -- Also stop follow modes if they were running
    if followConn then followConn:Disconnect() followConn = nil end
    if followModeConn then followModeConn:Disconnect() followModeConn = nil end
    if followModeTrack then pcall(function() followModeTrack:Stop() end); followModeTrack = nil end
    -- Hard clear PhysicsRepRootPart
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    if root and sethiddenproperty then
        pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
    end
    -- Force reset network ownership to server
    if root then
        pcall(function() root:SetNetworkOwner(nil) end)
    end
    -- Reset movement state
    if hum then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        hum.PlatformStand = false
    end
    altTarget = nil
    altMode = "none"
    local shared = (getgenv and getgenv()) or _G
    shared.STAND_FORCEHIT_LIVE = false
