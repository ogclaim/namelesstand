-- ,bring is OWNER-DRIVEN: the owner glues each alt (by known UserId) to their own
-- root from the owner's client - zero chat involvement, so alts with broken chat
-- still get brought. All other orders still go through alt-side chat hooks.
local function bringAltByUid(uid)
    print("[STAND-BRING] owner pull, alt uid", uid)
    local target = Players:GetPlayerByUserId(uid)
    if not target then
        print("[STAND-BRING] alt", uid, "not in server")
        return
    end
    local op = nil
    for i = 1, 60 do
        local oc = localPlayer.Character
        op = oc and (oc:FindFirstChild("HumanoidRootPart")
            or oc:FindFirstChild("RootPart")
            or oc:FindFirstChild("Torso")
            or oc:FindFirstChild("UpperTorso"))
        if op then break end
        task.wait(0.1)
    end
    if not op then
        print("[STAND-BRING] owner has no character - cannot pull")
        return
    end
    local tRoot = nil
    for i = 1, 30 do
        local tc = target.Character
        tRoot = tc and (tc:FindFirstChild("HumanoidRootPart")
            or tc:FindFirstChild("RootPart")
            or tc:FindFirstChild("Torso")
            or tc:FindFirstChild("UpperTorso"))
        if tRoot then break end
        task.wait(0.1)
    end
    if not tRoot then
        print("[STAND-BRING] alt", uid, "has no character yet")
        return
    end
    -- Landing spot: 5 studs beside the owner on the floor (raycast-corrected)
    local dir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
    if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
    local stand = op.Position + dir.Unit * 5
    local cast = workspace:Raycast(stand + Vector3.new(0, 8, 0), Vector3.new(0, -30, 0))
    if cast then stand = cast.Position end
    -- Phase 1 (0.5s): glue the alt's root to OUR root - the server accepts this
    -- as legit movement. Phase 2 (0.5s): unglue, hold at the landing spot.
    local glueEnd = tick() + 0.5
    while tick() < glueEnd do
        if sethiddenproperty then
            pcall(function() sethiddenproperty(tRoot, "PhysicsRepRootPart", op) end)
        end
        pcall(function()
            local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:SetPlatformState(Enum.PlatformState.Airborne) end
            tRoot.AssemblyLinearVelocity = Vector3.zero
            tRoot.CFrame = CFrame.new(op.Position + Vector3.new(0, 2, 0))
        end)
        task.wait()
    end
    local burstEnd = tick() + 0.5
    while tick() < burstEnd do
        if sethiddenproperty then
            pcall(function() sethiddenproperty(tRoot, "PhysicsRepRootPart", nil) end)
        end
        pcall(function()
            tRoot.AssemblyLinearVelocity = Vector3.zero
            tRoot.CFrame = CFrame.new(stand + Vector3.new(0, 1.5, 0))
        end)
        task.wait()
    end
    print("[STAND-BRING] pulled alt", uid, "to owner")
end

