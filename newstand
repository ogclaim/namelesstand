        pcall(function()
            readWhitelist()
            if not fi(ORDERS_FILE) then return end
            local data = rf(ORDERS_FILE)
            if not data then return end
            shared.STAND_POLL_RAN_ORDER = false
            
            -- db assignment NOTE: the owner types SEPARATE messages (",db bob",
            -- then ",db cassidy", then ",db joe"). Each fresh line opens or
            -- continues a batch; the k-th db line of the batch belongs to
            -- alt rank k. A single line that goes quiet (>3s) = gang: ALL
            -- alts hit it. Position is recomputed from the file every poll,
            -- so an alt injected mid-batch still finds its own slot.
            local dbQueue = {}
            -- Per-window dedupe by the raw line (clock-safe). The old
            -- wall-clock "newer" gate could silently eat a fresh order when
            -- clocks skewed - that is why a second ,bring typed minutes
            -- later did nothing. The 30s echo guard in writeOrder already
            -- keeps one copy per command in the file; here we only block
            -- re-runs of lines we have already executed.
            local seen = shared.STAND_RUN_LINES
            if type(seen) ~= "table" then seen = {} end
            local seenCount = 0
            for k in pairs(seen) do seenCount = seenCount + 1 end
            if seenCount > 256 then
                for k in pairs(seen) do seen[k] = nil end
            end
            shared.STAND_RUN_LINES = seen
            for line in data:gmatch("[^\r\n]+") do
                local n, t, a, rest = line:match("^(%d+)|(%d+)|(%d+)|(.*)$")
