                            end
                        end})
                    end})
                    utility:Connection({Type = uis.InputBegan, Callback = function(input, gpe)
                        if gpe then return end
                        if kb.binding then return end
                        if kb.key == Enum.KeyCode.Unknown then return end
                        local pressed = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType
                        if pressed == kb.key then
                            if kb.mode == "toggle" then
                                kb.active = not kb.active
                                kb_button.BackgroundColor3 = kb.active and Color3.fromRGB(170, 85, 235) or Color3.fromRGB(35, 35, 35)
                                if kb.flag then library.flags[kb.flag] = {mode = kb.mode, key = kb.key, active = kb.active} end
                                kb.callback(kb.active)
                            elseif kb.mode == "hold" then
                                kb.active = true
                                kb_button.BackgroundColor3 = Color3.fromRGB(170, 85, 235)
                                if kb.flag then library.flags[kb.flag] = {mode = kb.mode, key = kb.key, active = true} end
                                kb.callback(true)
                            end
                        end
