    local TCS = game:GetService("TextChatService")
    local ch = TCS:FindFirstChild("TextChannels")
    local function hook(channel)
        if not channel or not channel.MessageReceived then return end
        channel.MessageReceived:Connect(function(msg)
            local src = msg.TextSource
            local plr = src and Players:GetPlayerByUserId(src.UserId)
            if plr and msg.Text then onChat(plr, msg.Text) end
        end)
    end
    if ch then
        for _, c in ipairs(ch:GetChildren()) do hook(c) end
        ch.ChildAdded:Connect(hook)
    end
end)

