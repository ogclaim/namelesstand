local function lower(s) return tostring(s or ""):lower() end

function F.IsOwner(p)
    if not p then return false end
    local n = p.Name:lower()
    if n == ControllerName:lower() then return true end
    if ExtraOwners[n] then return true end
    return false
end

function F.IsControllerClient()
    return LocalPlayer.Name:lower() == ControllerName:lower()
end

function F.IsStandClient()
    return BotSet[LocalPlayer.Name:lower()] == true and not F.IsControllerClient()
end

function F.GetController()
    return Players:FindFirstChild(ControllerName)
end

function F.isWhitelisted(p)
    if not p then return false end
    return Whitelist[p.Name:lower()] == true or BotSet[p.Name:lower()] == true or F.IsOwner(p)
end

function F.BotChat(msg)
    pcall(function()
        local TCS = game:GetService("TextChatService")
        local ch = TCS and TCS:FindFirstChild("TextChannels") and TCS.TextChannels:FindFirstChild("RBXGeneral")
        if ch and ch.SendAsync then ch:SendAsync(tostring(msg)) return end
    end)
    pcall(function()
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local say = ev and ev:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(tostring(msg), "All") end
    end)
end

function F.root()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

function F.isKnocked(char)
    local be = char and char:FindFirstChild("BodyEffects")
    if not be then return false end
    local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
    local dead = be:FindFirstChild("Dead")
    return (ko and ko.Value) or (dead and dead.Value)
end

function F.isFullyAlive(p)
    local c = p and p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 or F.isKnocked(c) then return false end
    if c:FindFirstChildOfClass("ForceField") then return false end
    return c:FindFirstChild("HumanoidRootPart") ~= nil
end

function F.HasWallBetween(a, b)
    local ok, hit = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then filter[#filter + 1] = plr.Character end
        end
        params.FilterDescendantsInstances = filter
        return workspace:Raycast(a, b - a, params)
    end)
    return ok and hit ~= nil
end

-- Guns
local GUN_ALIASES = {
    uzi = {"uzi", "[uzi]", "smg"},
    rev = {"revolver", "[revolver]", "rev"},
    db = {"double-barrel", "doublebarrel", "[double-barrel]", "db"},
    sg = {"shotgun", "[shotgun]", "sg"},
    tacticalsg = {"tacticalshotgun", "tactical shotgun", "[tactical shotgun]", "tacticalsg", "tactical"},
    silencer = {"silencer", "[silencer]"},
}

function F.CollectGuns()
    local guns = {}
    local char, bag = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
    local function add(t)
        if t and t:IsA("Tool") and not t.Name:lower():find("knife") then guns[#guns + 1] = t end
    end
    if char then for _, t in ipairs(char:GetChildren()) do add(t) end end
    if bag then for _, t in ipairs(bag:GetChildren()) do add(t) end end
    return guns
end

function F.FindGunByKey(key)
    local aliases = GUN_ALIASES[lower(key)]
    if not aliases then return nil end
    for _, tool in ipairs(F.CollectGuns()) do
        local n = tool.Name:lower()
        for _, a in ipairs(aliases) do
            if n == a or n:find(a, 1, true) then return tool end
        end
    end
    return nil
end

function F.SelectGun(key)
    key = lower(key)
    if not GUN_ALIASES[key] then
        F.BotChat("Selected gun = " .. key .. " not found!")
        return false
    end
    SelectedGunKey = key
    local tool = F.FindGunByKey(key)
    if tool then
        UseGun = true
        pcall(function() tool.Parent = LocalPlayer.Character end)
        LockedGunTool = tool
        F.BotChat("Selected gun = " .. key .. " found!")
        return true
    end
    F.BotChat("Selected gun = " .. key .. " not found!")
    return false
end

function F.EquipGun()
    if SelectedGunKey then
        local t = F.FindGunByKey(SelectedGunKey)
        if t then pcall(function() t.Parent = LocalPlayer.Character end) LockedGunTool = t return t end
    end
    local guns = F.CollectGuns()
    if guns[1] then
        pcall(function() guns[1].Parent = LocalPlayer.Character end)
        LockedGunTool = guns[1]
        return guns[1]
    end
    return nil
end

function F.EquipKnife()
    local char = LocalPlayer.Character
    local bag = LocalPlayer:FindFirstChild("Backpack")
    local knife = char and (char:FindFirstChild("[Knife]") or char:FindFirstChild("Knife"))
    if not knife and bag then knife = bag:FindFirstChild("[Knife]") or bag:FindFirstChild("Knife") end
    if knife then pcall(function() knife.Parent = char end) end
    return knife
end

-- ForceHit (NeverLarp-style packet)
function F.FireForceHit(target)
    if not MainEvent or not target then return false end
    local now = tick()
    if ForceHitFireRate > 0 and now - (_lastFHFire or 0) < ForceHitFireRate then return false end
    local tChar = target.Character
    if not tChar or not F.isFullyAlive(target) then return false end
    local hitPart = tChar:FindFirstChild("Head") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("HumanoidRootPart")
    if not hitPart then return false end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool or tool.Name:lower():find("knife") then tool = F.EquipGun() end
    if not tool or not tool:FindFirstChild("Handle") then return false end
    local handlePos = tool.Handle.Position
    local hitPos = hitPart.Position
    local volleys = RapidFireEnabled and (RapidFireVolleys or 3) or 1
    for _ = 1, volleys do
        getgenv().FH_Index = ((getgenv().FH_Index or 0) + 1) % 100
        local packet = {
            INDEX = getgenv().FH_Index,
            AIM = hitPos + (hitPos - handlePos).Unit * 25,
            ORIGIN = handlePos,
            HITS = {{ PELLET = 1, POSITION = hitPos, MODEL = tChar, PART = hitPart }},
        }
        pcall(function() MainEvent:FireServer("Shoot", packet) end)
    end
    _lastFHFire = now
    return true
end

function F.TryReload()
    if not MainEvent then return end
    pcall(function() MainEvent:FireServer("Reload") end)
end

-- Glue (simple CFrame stick for summon/orbit)
local glueConn = nil
function F.StopGlue()
    if glueConn then glueConn:Disconnect() glueConn = nil end
    GlueMode = nil
end

function F.StartGlueFollow()
    F.StopGlue()
    GlueMode = "follow"
    glueConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "follow" and CurrentAction ~= "formation" and not ProtectOwnerEnabled then
            return
        end
        local r = F.root()
        if not r then return end
        if ProtectOwnerEnabled then
            local c = F.GetController()
            local cr = c and c.Character and c.Character:FindFirstChild("HumanoidRootPart")
            if cr then r.CFrame = cr.CFrame end
            return
        end
        local cf
        if CurrentAction == "formation" then
            cf = F.GetAroundCF()
        else
            cf = F.GetSummonCF()
        end
        if cf then
            r.CFrame = cf
            pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
        end
    end)
end

function F.GetSummonCF()
    local c = F.GetController()
    local cr = c and c.Character and c.Character:FindFirstChild("HumanoidRootPart")
    if not cr then return nil end
    local slot = MySlot or 1
    local i = slot - 1
    local b = cr.CFrame
    local look, right = b.LookVector, b.RightVector
    local col = i % 3
    local row = math.floor(i / 3)
    local pos = cr.Position - look * (FollowBack + row * FollowBack) + right * ((col - 1) * FollowSpacing) + Vector3.new(0, FollowHeight + row * 1.5, 0)
    return CFrame.new(pos, pos + look)
end

function F.GetAroundCF()
    local c = F.GetController()
    local cr = c and c.Character and c.Character:FindFirstChild("HumanoidRootPart")
    if not cr then return nil end
    local slot = MySlot or 1
    local look, right = cr.CFrame.LookVector, cr.CFrame.RightVector
    local dirs = { -look, look, -right, right }
    local pillar = ((slot - 1) % 4) + 1
    local stack = math.floor((slot - 1) / 4)
    local d = dirs[pillar]
    local pos = cr.Position + d * 5 + Vector3.new(0, 5 + stack * StackHeight, 0)
    return CFrame.new(pos, pos + look)
end

function F.StopAll()
    CurrentAction = "idle"
    TargetPlayer = nil
    TargetList = {}
    F.StopGlue()
    if FollowConnection then FollowConnection:Disconnect() FollowConnection = nil end
    if KillAttackConn then KillAttackConn:Disconnect() KillAttackConn = nil end
    ProtectOwnerEnabled = false
    if ProtectOwnerConn then ProtectOwnerConn:Disconnect() ProtectOwnerConn = nil end
end

function F.StartFollow()
    if F.IsControllerClient() then return end
    F.StopAll()
    CurrentAction = "follow"
    F.StartGlueFollow()
end

function F.StartAround()
    if F.IsControllerClient() then return end
    F.StopAll()
    CurrentAction = "formation"
    F.StartGlueFollow()
end

function F.StartProtectOwner()
    if F.IsControllerClient() then return end
    ProtectOwnerEnabled = true
    CurrentAction = "protect"
    F.StartGlueFollow()
end

function F.StopProtectOwner()
    ProtectOwnerEnabled = false
    if CurrentAction == "protect" then F.StopAll() end
end

-- Kill positions
function F.GetKillCF(tRoot)
    if not tRoot then return nil end
    local dist = KillDistance or 10
    local pos = KillPosition or "Top"
    local look = tRoot.CFrame.LookVector
    local right = tRoot.CFrame.RightVector
    local origin = tRoot.Position
    local off
    if pos == "Top" then off = Vector3.new(0, dist, 0)
    elseif pos == "Bottom" then off = Vector3.new(0, -dist, 0)
    elseif pos == "Front" then off = look * dist
    elseif pos == "Back" then off = -look * dist
    elseif pos == "Left" then off = -right * dist
    elseif pos == "Right" then off = right * dist
    else off = Vector3.new(0, dist, 0)
    end
    local p = origin + off
    return CFrame.new(p, origin)
end

function F.DoStomp(target)
    local tc = target and target.Character
    if not tc then return end
    local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("HumanoidRootPart")
    local r = F.root()
    if not ut or not r then return end
    r.CFrame = CFrame.new(ut.Position + Vector3.new(0, 3.4, 0))
    if MainEvent then
        for _ = 1, 5 do pcall(function() MainEvent:FireServer("Stomp") end) end
    end
end

function F.StartKill(targets, auto)
    if F.IsControllerClient() then return end
    if type(targets) ~= "table" then targets = { targets } end
    if #targets == 0 then return end
    F.StopAll()
    TargetList = targets
    TargetIndex = 1
    TargetPlayer = targets[1]
    CurrentAction = auto and "autokill" or "kill"
    local voidPhase, voidUntil = "surface", 0
    KillAttackConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then return end
        local t = TargetList[TargetIndex]
        if not t or not t.Parent then
            if CurrentAction == "autokill" then return end
            F.StopAll()
            return
        end
        if not t.Character then return end
        local r = F.root()
        local tr = t.Character:FindFirstChild("HumanoidRootPart")
        if not r or not tr then return end

        if F.isKnocked(t.Character) then
            F.DoStomp(t)
            WaitFFUntil = tick() + WaitFFDelay
            if CurrentAction == "kill" then
                F.StopAll()
                return
            end
            -- autokill: wait for respawn/FF clear
            return
        end

        if tick() < (WaitFFUntil or 0) then return end
        if not F.isFullyAlive(t) then return end

        if KillMethod == "spamvoid" then
            local now = tick()
            if voidPhase == "surface" then
                local cf = F.GetKillCF(tr)
                if cf then r.CFrame = cf end
                if UseGun then F.EquipGun() F.FireForceHit(t) F.TryReload()
                else local k = F.EquipKnife() if k then pcall(function() k:Activate() end) end end
                voidPhase = "void"
                voidUntil = now + (UseGun and GunSpamVoidIn or KnifeSpamVoidIn)
            else
                r.CFrame = CFrame.new(r.Position.X, -500, r.Position.Z)
                if now >= voidUntil then
                    voidPhase = "surface"
                    voidUntil = now + (UseGun and GunSpamVoidOut or KnifeSpamVoidOut)
                end
            end
        else
            -- orbit
            local angle = tick() * (OrbitSpeed or 30)
            local dist = GunOrbitDist or 10
            local o = tr.Position + Vector3.new(math.cos(angle) * dist, OrbitHeight or 3, math.sin(angle) * dist)
            r.CFrame = CFrame.new(o, tr.Position)
            if UseGun then
                F.EquipGun()
                F.FireForceHit(t)
                F.TryReload()
            else
                local k = F.EquipKnife()
                if k then pcall(function() k:Activate() end) end
            end
        end
    end)
end

function F.StartKillAura()
    if KillAuraConnection then KillAuraConnection:Disconnect() end
    KillAuraEnabled = true
    local last = 0
    KillAuraConnection = RunService.Heartbeat:Connect(function()
        if not KillAuraEnabled then return end
        local r = F.root()
        if not r then return end
        F.EquipGun()
        local best, bd = nil, (KillAuraRange or 80) + 0.01
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and not F.isWhitelisted(p) and F.isFullyAlive(p) then
                local h = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - r.Position).Magnitude
                    if d < bd and d <= (KillAuraRange or 80) then
                        if not F.HasWallBetween(r.Position, h.Position) then
                            best, bd = p, d
                        end
                    end
                end
            end
        end
        if best and tick() - last > (KillAuraDelay or 0.06) then
            if F.FireForceHit(best) then last = tick() end
        end
    end)
end

function F.StopKillAura()
    KillAuraEnabled = false
    if KillAuraConnection then KillAuraConnection:Disconnect() KillAuraConnection = nil end
end

function F.SetOptMode(on)
    OptMode = on and true or false
    if not OptMode then return end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function()
        local L = game:GetService("Lighting")
        L.GlobalShadows = false
    end)
    task.spawn(function()
        while OptMode do
            local r = F.root()
            if r then
                local origin, range2 = r.Position, (OptCullRange or 50)^2
                for _, child in ipairs(workspace:GetChildren()) do
                    local isChar = false
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr.Character == child then isChar = true break end
                    end
                    if not isChar and not child:IsA("Terrain") then
                        local pp = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                        if pp then
                            local d2 = (pp.Position - origin).Magnitude
                            local hide = d2 * d2 > range2
                            if child:IsA("BasePart") then
                                child.LocalTransparencyModifier = hide and 1 or 0
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

function F.FindPlayer(name)
    if not name then return nil end
    name = lower(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or p.DisplayName:lower() == name then return p end
        if p.Name:lower():sub(1, #name) == name then return p end
    end
    return nil
end

function F.ParseTargets(args, startIdx)
    local out = {}
    for i = startIdx, #args do
        local p = F.FindPlayer(args[i])
        if p then out[#out + 1] = p end
    end
    return out
end

function F.OnChatted(player, message)
    if not F.IsOwner(player) then return end
    if F.IsControllerClient() then return end -- controller does not listen to self for bot actions when same account
    -- stands execute; if controller is separate they chat and stands hear
    message = lower(message):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    if message:sub(1, #PREFIX) ~= PREFIX then return end
    local body = message:sub(#PREFIX + 1)
    local args = {}
    for w in body:gmatch("%S+") do args[#args + 1] = w end
    local cmd = args[1]
    if not cmd then return end

    if cmd == "stop" or cmd == "idle" then
        F.StopAll()
        F.StopKillAura()
    elseif cmd == "return" or cmd == "summon" or cmd == "follow" or cmd == "come" then
        F.StopProtectOwner()
        F.StartFollow()
    elseif cmd == "around" then
        F.StartAround()
    elseif cmd == "orbit" then
        local a2 = args[2] and lower(args[2]) or ""
        if a2 == "top" or a2 == "bottom" or a2 == "back" or a2 == "front" or a2 == "left" or a2 == "right" then
            KillPosition = a2:sub(1,1):upper() .. a2:sub(2)
        end
        KillMethod = "orbit"
        OrbitEnabled = true
    elseif cmd == "gunspamkill" or cmd == "gsk" then
        UseGun = true
        KillMethod = "spamvoid"
    elseif cmd == "knifespamkill" or cmd == "ksk" then
        UseGun = false
        KillMethod = "spamvoid"
    elseif cmd == "kill" or cmd == "k" then
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, false) end
    elseif cmd == "autokill" or cmd == "ak" or cmd == "a" then
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "aorbit" then
        KillMethod = "orbit"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "agsk" then
        UseGun = true
        KillMethod = "spamvoid"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "aksk" then
        UseGun = false
        KillMethod = "spamvoid"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "ka" or cmd == "killaura" then
        local n = tonumber(args[2])
        if n then KillAuraRange = math.clamp(n, 5, 300) end
        if args[2] == "off" then F.StopKillAura()
        else F.StartKillAura() end
    elseif cmd == "opt" or cmd == "optimize" then
        if args[2] == "off" then OptMode = false
        else F.SetOptMode(true) end
    elseif cmd == "powner" or cmd == "protectowner" then
        F.StartProtectOwner()
    elseif cmd == "unpowner" or cmd == "unprotectowner" then
        F.StopProtectOwner()
    elseif cmd == "rapid" or cmd == "rapidfire" then
        if args[2] == "off" then RapidFireEnabled = false
        else RapidFireEnabled = true end
    elseif cmd == "transfer" then
        local p = F.FindPlayer(args[2])
        if p then
            ControllerName = p.Name
            ExtraOwners = {}
            Whitelist[p.Name:lower()] = true
            F.BotChat("controller -> " .. p.Name)
        end
    elseif cmd == "whitelist" or cmd == "wl" then
        local p = F.FindPlayer(args[2])
        if p then
            Whitelist[p.Name:lower()] = true
            F.BotChat("wl " .. p.Name)
        end
    elseif cmd == "ghold" or cmd == "hold" then
        HoldMode = "gun"
        UseGun = true
    elseif cmd == "khold" then
        HoldMode = "knife"
        UseGun = false
    elseif cmd == "uzi" or cmd == "rev" or cmd == "db" or cmd == "sg"
        or cmd == "tacticalsg" or cmd == "silencer" then
        F.SelectGun(cmd)
    elseif cmd == "gun" then UseGun = true
    elseif cmd == "knife" then UseGun = false
    end
end

