    print("[STAND-ALT] stopAttack: definitive stop executed")
end
local function startAttack(target)
    if isOwner then return end
    stopAttack()
    stopFollow()
    if flyHardStop then pcall(function() flyHardStop() end) end
    altTarget = target
    altMode = "knife"
    print("[STAND-ATTACK] surround + attack:", altTarget.Name)

    -- Permanent glue to target
    glueConn = RunService.Heartbeat:Connect(function()
        if copyIsStale() then clearGlue(); if glueConn then glueConn:Disconnect() end return end
        if not altTarget or not altTarget.Parent then stopAttack(); startFollow(); return end
        if not sethiddenproperty then return end
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if not root then return end
