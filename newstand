        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if not char or not root then return end

        if targetPart and not targetIsKO then
            pcall(function() root:SetNetworkOwner(localPlayer) end)

            -- Formation position around target (uses KNIFE_SLOTS)
            local spot = getFormationPos(targetPart.Position, targetPart.CFrame.LookVector)
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                -- Set position to formation spot + face target
                root:PivotTo(CFrame.lookAt(spot, targetPart.Position))
            end)

            -- Glue as safety net for extreme velocities
            if sethiddenproperty then
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", targetPart) end)
            end

            local knife = equipKnife()
            if knife then
                expandHitbox()
                pcall(function() knife:Activate() end)
            end

        elseif targetIsKO then
            -- Stomp once, void to 20B, wait for respawn, return
            if not stompDone then
                local torso = altTarget.Character:FindFirstChild("UpperTorso") or altTarget.Character:FindFirstChild("Torso")
                if torso then pcall(function() root.CFrame = CFrame.new(torso.Position + Vector3.new(0, 3, 0)) end) end
                if tick() - lastStompTime >= 0.1 then
                    pcall(function() MainEvent:FireServer("Stomp") end)
                    lastStompTime = tick()
                    stompDone = true
                end
            else
                local tHum = altTarget.Character and altTarget.Character:FindFirstChildOfClass("Humanoid")
                if tHum and tHum.Health > 0 and not isTargetKO() then
                    stompDone = false
                else
                    pcall(function() root.CFrame = CFrame.new(root.Position.X, 20000000000, root.Position.Z) end)
                    if sethiddenproperty then pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end) end
                end
            end
        end
    end)
end

