RunService.Heartbeat:Connect(function(dt)
    if copyIsStale() then return end
    if not dzState.enabled then
        dzState.target_position = nil
        return
    end
    local char = localPlayer.Character
    if not char then return end
    if HV.toolCheck and char:FindFirstChildWhichIsA("Tool") then
        dzState.target_position = nil
        dzResetCamera()
        dzSetback.CFrame = CFrame.new(0, -2000, 0)
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    dzState.old_position = root.CFrame
    local target = dzState.old_position
    if dzState.mode == "void" then
        target = CFrame.new(root.Position + Vector3.new(math.random(-9e8, 9e8), math.random(1e8, 9e8), math.random(-9e8, 9e8)))
    elseif dzState.mode == "spam void" then
        dzState.timer = dzState.timer + dt
        if dzState.timer < dzState.void_time then
            target = CFrame.new(root.Position + Vector3.new(math.random(-9e8, 9e8), math.random(1e8, 9e8), math.random(-9e8, 9e8)))
        end
        if dzState.timer >= dzState.void_time + dzState.normal_time then dzState.timer = 0 end
    elseif dzState.mode == "Chaos" then
        local t = tick() * 999
        target = CFrame.new(root.Position + Vector3.new(math.sin(t) * 9e8, math.abs(math.cos(t * 1.3)) * 9e8, math.sin(t * 0.7) * 9e8))
    elseif dzState.mode == "Epilepsy" then
        local flip = math.floor(tick() * 60) % 2 == 0
        target = flip and CFrame.new(root.Position + Vector3.new(9e8, 9e8, 9e8)) or CFrame.new(root.Position + Vector3.new(-9e8, -9e8, -9e8))
    elseif dzState.mode == "Custom" then
        target = dzState.old_position + dzState.custom_offset
    elseif dzState.mode == "Underground" then
        target = CFrame.new(root.Position - Vector3.new(0, 6, 0)) * CFrame.Angles(math.pi / 2, 0, 0)
    end
    dzState.target_position = target
    dzIndLastPos = target.Position
    root.CFrame = target
    dzSetback.CFrame = dzState.old_position
    Camera.CameraSubject = dzSetback
    RunService.RenderStepped:Wait()
    root.CFrame = dzState.old_position
    dzSetback.CFrame = CFrame.new(0, -2000, 0)
    dzResetCamera()
end)

