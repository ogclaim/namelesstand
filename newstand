local function onChat(player, message)
    if not isOwner(player) then return end
    local body = parsePrefix(message)
    if not body then return end
    local args = {}
    for w in body:gmatch("%S+") do args[#args + 1] = w:lower() end
    local cmd = args[1]
    if not cmd then return end

    if cmd == "stop" or cmd == "idle" then
        stopAll()
    elseif cmd == "summon" or cmd == "follow" or cmd == "come" then
        startFollow()
    elseif cmd == "return" or cmd == "s" or cmd == "teleport" or cmd == "tp" then
        startFollow()
    elseif cmd == "gun" then
        UseGun = true
        equipSelected()
    elseif cmd == "knife" and not args[2] then
        UseGun = false
        equipSelected()
    elseif cmd == "rifle" or cmd == "db" or cmd == "rev" or cmd == "silencer" or cmd == "lmg" or cmd == "flintlock" or cmd == "aug" then
        SelectedGun = cmd
        UseGun = true
        equipSelected()
    elseif cmd == "orbit" or cmd == "orbitkill" then
        KillMethod = "orbit"
    elseif cmd == "skykill" or cmd == "sky" then
        KillMethod = "sky"
    elseif cmd == "standkill" or cmd == "stand" then
        KillMethod = "stand"
    elseif cmd == "stkill" or cmd == "stk" then
        KillMethod = "stkill"
    elseif cmd == "tkill" or cmd == "tweenkill" then
        KillMethod = "tkill"
    elseif cmd == "kill" or cmd == "k" then
        local targets = {}
        for i = 2, #args do
            local p = findPlayer(args[i])
            if p then targets[#targets + 1] = p end
        end
        if #targets > 0 then startKill(targets, false) end
    elseif cmd == "autokill" or cmd == "ak" or cmd == "a" then
        local targets = {}
        for i = 2, #args do
            local p = findPlayer(args[i])
            if p then targets[#targets + 1] = p end
        end
        if #targets > 0 then startKill(targets, true) end
    elseif cmd == "bring" or cmd == "b" or cmd == "get" then
        local p = findPlayer(args[2])
        if p then startBring(p) end
    elseif cmd == "stomp" then
        if args[2] == "off" then StompOnKill = false
        elseif args[2] == "on" then StompOnKill = true
        else StompOnKill = not StompOnKill end
    elseif cmd == "autostomp" then
        if args[2] == "off" then AutoStompEnabled = false
        elseif args[2] == "on" then AutoStompEnabled = true
        else AutoStompEnabled = not AutoStompEnabled end
    elseif cmd == "slot" and args[2] then
        local n = tonumber(args[2])
        if n then MySlot = math.clamp(math.floor(n), 1, MaxBots) end
    elseif cmd == "transfer" and args[2] then
        ControllerName = args[2]
    elseif cmd == "reclaim" or cmd == "revert" then
        ControllerName = OriginalControllerName
    elseif cmd == "whitelist" or cmd == "wl" then
        if args[2] then Whitelist[args[2]:lower()] = true end
    elseif cmd == "unwhitelist" or cmd == "unwl" then
        if args[2] then Whitelist[args[2]:lower()] = nil end
    elseif cmd == "reset" or cmd == "r" then
        local hum = getHum(LocalPlayer.Character)
        if hum then pcall(function() hum.Health = 0 end) end
    elseif cmd == "leave" or cmd == "l" then
        pcall(function() LocalPlayer:Kick("left") end)
    elseif cmd == "help" or cmd == "cmds" then
        print("[NAMELESS DH] kill/ak/bring/summon/gun/knife/skykill/standkill/orbit/stkill/tkill/stop")
    end
end

