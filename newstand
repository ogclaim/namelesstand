-- Kill positions
F.GetKillCF = function(tRoot)
    if not tRoot then return nil end
    local dist = KillDistance or 10
    local pos = KillPosition or "Top"
    local look = tRoot.CFrame.LookVector
    local right = tRoot.CFrame.RightVector
    local origin = tRoot.Position
    local off
    if pos == "Top" then off = Vector3.new(0, dist, 0)
    elseif pos == "Bottom" then off = Vector3.new(0, -dist, 0)
    elseif pos == "Front" then off = look * dist
    elseif pos == "Back" then off = -look * dist
    elseif pos == "Left" then off = -right * dist
    elseif pos == "Right" then off = right * dist
    else off = Vector3.new(0, dist, 0)
    end
    local p = origin + off
    return CFrame.new(p, origin)
end

F.DoStomp = function(target)
    local tc = target and target.Character
    if not tc then return end
    local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("HumanoidRootPart")
    local r = F.root()
    if not ut or not r then return end
    r.CFrame = CFrame.new(ut.Position + Vector3.new(0, 3.4, 0))
    if MainEvent then
        for _ = 1, 5 do pcall(function() MainEvent:FireServer("Stomp") end) end
    end
end

F.StartKill = function(targets, auto)
    if F.IsControllerClient() then return end
    if type(targets) ~= "table" then targets = { targets } end
    if #targets == 0 then return end
    F.StopAll()
    TargetList = targets
    TargetIndex = 1
    TargetPlayer = targets[1]
    CurrentAction = auto and "autokill" or "kill"
    GlueTargetPlayer = TargetPlayer
    if UseGun then
        F.StartGlue("gun", TargetPlayer)
    else
        F.StartGlue("knife", TargetPlayer)
    end
    local voidPhase, voidUntil = "surface", 0
    KillAttackConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then return end
        local t = TargetList[TargetIndex]
        if not t or not t.Parent then
            if CurrentAction == "autokill" then return end
            F.StopAll()
            return
        end
        if not t.Character then return end
        local r = F.root()
        local tr = t.Character:FindFirstChild("HumanoidRootPart")
        if not r or not tr then return end

        if F.isKnocked(t.Character) then
            F.DoStomp(t)
            if CurrentAction == "kill" then
                F.StopAll()
                return
            end
            -- autokill: wait until alive and no forcefield
            return
        end

        if not F.isFullyAlive(t) then return end
        -- do not shoot while forcefield is active
        if t.Character and t.Character:FindFirstChildOfClass("ForceField") then return end

        if KillMethod == "spamvoid" then
            local now = tick()
            if voidPhase == "surface" then
                local cf = F.GetKillCF(tr)
                if cf then r.CFrame = cf end
                if UseGun then F.EquipGun() F.FireForceHit(t) F.TryReload()
                else local k = F.EquipKnife() if k then pcall(function() k:Activate() end) end end
                voidPhase = "void"
                voidUntil = now + (UseGun and GunSpamVoidIn or KnifeSpamVoidIn)
            else
                r.CFrame = CFrame.new(r.Position.X, -500, r.Position.Z)
                if now >= voidUntil then
                    voidPhase = "surface"
                    voidUntil = now + (UseGun and GunSpamVoidOut or KnifeSpamVoidOut)
                end
            end
        else
            -- orbit
            local angle = tick() * (OrbitSpeed or 30)
            local dist = GunOrbitDist or 10
            local o = tr.Position + Vector3.new(math.cos(angle) * dist, OrbitHeight or 3, math.sin(angle) * dist)
            r.CFrame = CFrame.new(o, tr.Position)
            if UseGun then
                F.EquipGun()
                F.FireForceHit(t)
                F.TryReload()
            else
                local k = F.EquipKnife()
                if k then pcall(function() k:Activate() end) end
            end
        end
    end)
end

F.StartKillAura = function()
    if KillAuraConnection then KillAuraConnection:Disconnect() end
    KillAuraEnabled = true
    local last = 0
    KillAuraConnection = RunService.Heartbeat:Connect(function()
        if not KillAuraEnabled then return end
        local r = F.root()
        if not r then return end
        F.EquipGun()
        local best, bd = nil, (KillAuraRange or 80) + 0.01
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and not F.isWhitelisted(p) and F.isFullyAlive(p) then
                local h = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - r.Position).Magnitude
                    if d < bd and d <= (KillAuraRange or 80) then
                        if not F.HasWallBetween(r.Position, h.Position) then
                            best, bd = p, d
                        end
                    end
                end
            end
        end
        if best and tick() - last > (KillAuraDelay or 0.06) then
            if F.FireForceHit(best) then last = tick() end
        end
    end)
end

F.StopKillAura = function()
