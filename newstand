function F.root()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

function F.isKnocked(char)
    local be = char and char:FindFirstChild("BodyEffects")
    if not be then return false end
    local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
    local dead = be:FindFirstChild("Dead")
    return (ko and ko.Value) or (dead and dead.Value)
end

function F.isFullyAlive(p)
    local c = p and p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 or F.isKnocked(c) then return false end
    if c:FindFirstChildOfClass("ForceField") then return false end
    return c:FindFirstChild("HumanoidRootPart") ~= nil
end

function F.HasWallBetween(a, b)
    local ok, hit = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then filter[#filter + 1] = plr.Character end
        end
        params.FilterDescendantsInstances = filter
        return workspace:Raycast(a, b - a, params)
    end)
    return ok and hit ~= nil
end

-- Guns
local GUN_ALIASES = {
    uzi = {"uzi", "[uzi]", "smg"},
    rev = {"revolver", "[revolver]", "rev"},
    db = {"double-barrel", "doublebarrel", "[double-barrel]", "db"},
    sg = {"shotgun", "[shotgun]", "sg"},
    tacticalsg = {"tacticalshotgun", "tactical shotgun", "[tactical shotgun]", "tacticalsg", "tactical"},
    silencer = {"silencer", "[silencer]"},
}

function F.CollectGuns()
    local guns = {}
    local char, bag = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
    local function add(t)
        if t and t:IsA("Tool") and not t.Name:lower():find("knife") then guns[#guns + 1] = t end
    end
    if char then for _, t in ipairs(char:GetChildren()) do add(t) end end
    if bag then for _, t in ipairs(bag:GetChildren()) do add(t) end end
    return guns
end

function F.FindGunByKey(key)
    local aliases = GUN_ALIASES[lower(key)]
    if not aliases then return nil end
    for _, tool in ipairs(F.CollectGuns()) do
        local n = tool.Name:lower()
        for _, a in ipairs(aliases) do
            if n == a or n:find(a, 1, true) then return tool end
        end
    end
    return nil
end

function F.SelectGun(key)
    key = lower(key)
    if not GUN_ALIASES[key] then
        F.BotChat("Selected gun = " .. key .. " not found!")
        return false
    end
    SelectedGunKey = key
    local tool = F.FindGunByKey(key)
    if tool then
        UseGun = true
        pcall(function() tool.Parent = LocalPlayer.Character end)
        LockedGunTool = tool
        F.BotChat("Selected gun = " .. key .. " found!")
        return true
    end
    F.BotChat("Selected gun = " .. key .. " not found!")
    return false
end

function F.EquipGun()
    if SelectedGunKey then
        local t = F.FindGunByKey(SelectedGunKey)
        if t then pcall(function() t.Parent = LocalPlayer.Character end) LockedGunTool = t return t end
    end
    local guns = F.CollectGuns()
    if guns[1] then
        pcall(function() guns[1].Parent = LocalPlayer.Character end)
        LockedGunTool = guns[1]
        return guns[1]
    end
    return nil
end

function F.EquipKnife()
    local char = LocalPlayer.Character
    local bag = LocalPlayer:FindFirstChild("Backpack")
    local knife = char and (char:FindFirstChild("[Knife]") or char:FindFirstChild("Knife"))
    if not knife and bag then knife = bag:FindFirstChild("[Knife]") or bag:FindFirstChild("Knife") end
    if knife then pcall(function() knife.Parent = char end) end
    return knife
end

-- ForceHit (NeverLarp-style packet)
function F.FireForceHit(target)
    if not MainEvent or not target then return false end
    local now = tick()
    if ForceHitFireRate > 0 and now - (_lastFHFire or 0) < ForceHitFireRate then return false end
    local tChar = target.Character
    if not tChar or not F.isFullyAlive(target) then return false end
    local hitPart = tChar:FindFirstChild("Head") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("HumanoidRootPart")
    if not hitPart then return false end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool or tool.Name:lower():find("knife") then tool = F.EquipGun() end
    if not tool or not tool:FindFirstChild("Handle") then return false end
    local handlePos = tool.Handle.Position
    local hitPos = hitPart.Position
    local volleys = RapidFireEnabled and (RapidFireVolleys or 3) or 1
    for _ = 1, volleys do
        getgenv().FH_Index = ((getgenv().FH_Index or 0) + 1) % 100
        local packet = {
            INDEX = getgenv().FH_Index,
            AIM = hitPos + (hitPos - handlePos).Unit * 25,
            ORIGIN = handlePos,
            HITS = {{ PELLET = 1, POSITION = hitPos, MODEL = tChar, PART = hitPart }},
        }
        pcall(function() MainEvent:FireServer("Shoot", packet) end)
    end
    _lastFHFire = now
    return true
end

-- NeverLarp-style auto reload (Ammo == 0 → press R)
local _ReloadLast = {}
local _ReloadCD = 0.8
local LastReload = 0
function F.TryReload()
    local char = LocalPlayer.Character
    if not char then return end
    local function checkTool(tool)
        if not tool or not tool:IsA("Tool") then return end
        if tool.Name:lower():find("knife") then return end
        local last = _ReloadLast[tool.Name] or 0
        if tick() - last < _ReloadCD then return end
        local scr = tool:FindFirstChild("Script")
        local ammo = scr and scr:FindFirstChild("Ammo")
        if not ammo then
            ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AMMO")
        end
        if ammo and ammo:IsA("IntValue") and ammo.Value == 0 then
            _ReloadLast[tool.Name] = tick()
            LastReload = tick()
            pcall(function()
                if VirtualInputManager then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                    task.wait(0.03)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                end
            end)
            pcall(function()
                if MainEvent then MainEvent:FireServer("Reload") end
            end)
        elseif not ammo then
            if tick() - LastReload > 1.5 then
                LastReload = tick()
                pcall(function()
                    if VirtualInputManager then
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                        task.wait(0.03)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                    end
                end)
                pcall(function()
                    if MainEvent then MainEvent:FireServer("Reload") end
                end)
            end
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then checkTool(tool) end
    end
    local bag = LocalPlayer:FindFirstChild("Backpack")
    if bag then
        for _, tool in ipairs(bag:GetChildren()) do
            if tool:IsA("Tool") then checkTool(tool) end
        end
    end
end

