local function posSky(slot, targetRoot)
    local a = ((slot - 1) / math.max(MaxBots, 1)) * math.pi * 2
    local r = 12
    return CFrame.new(targetRoot.Position + Vector3.new(math.cos(a) * r, 200, math.sin(a) * r), targetRoot.Position)
end

local function posStand(slot, targetRoot)
    -- behind target at 3 studs (slot spreads slightly left/right)
    local side = ((slot - 1) % 5 - 2) * 1.2
    return targetRoot.CFrame * CFrame.new(side, 1.5, 3)
end

local function posOrbit(slot, targetRoot, ang)
    local a = ang + ((slot - 1) / math.max(MaxBots, 1)) * math.pi * 2
    local r = OrbitRadius or 5
    return CFrame.new(targetRoot.Position + Vector3.new(math.cos(a) * r, 2, math.sin(a) * r), targetRoot.Position)
end

local function killStep(target)
    if not target or isWhitelisted(target) then return true end
    local tChar = getChar(target)
    if not tChar or isKO(tChar) then return true end
    if hasForceField(tChar) then return false end
    local tr = getRoot(tChar)
    local my = getRoot(LocalPlayer.Character)
    if not tr or not my then return false end

    my.CanCollide = false

    if KillMethod == "skykill" then
        my.CFrame = posSky(MySlot, tr)
        shootTarget(target)
    elseif KillMethod == "standkill" then
        my.CFrame = posStand(MySlot, tr)
        shootTarget(target)
    elseif KillMethod == "orbitkill" then
        OrbitAngle = OrbitAngle + (OrbitSpeed or 4) * 0.05
        my.CFrame = posOrbit(MySlot, tr, OrbitAngle)
        shootTarget(target)
    elseif KillMethod == "knifekill" then
        if MySlot == 1 then
            startGlue("knife", target)
            knifeHit(target)
        else
            my.CFrame = posStand(MySlot, tr)
        end
    elseif KillMethod == "stkill" then
        -- handled in dedicated loop (spam teleport kill)
        return false
    else
        OrbitAngle = OrbitAngle + 0.15
        my.CFrame = posOrbit(MySlot, tr, OrbitAngle)
        shootTarget(target)
    end
    my.AssemblyLinearVelocity = Vector3.zero
    return false
end

local function startKill(targets, isAuto, method)
    stopAll()
    if typeof(targets) ~= "table" then targets = { targets } end
    local filtered = {}
    for _, p in ipairs(targets) do
        if p and not isWhitelisted(p) then filtered[#filtered + 1] = p end
    end
    if #filtered == 0 then return end
    if method then KillMethod = method end
    if KillMethod ~= "knifekill" then
        if #SelectedGuns == 0 then SelectedGuns = { "rifle" } end
        equipSelectedGuns()
    end
    TargetList = filtered
    TargetPlayer = filtered[1]
    CurrentAction = isAuto and "autokill" or "kill"

    -- !stkill / spam teleport kill
    if KillMethod == "stkill" then
        ActionConn = nil
        task.spawn(function()
            while CurrentAction == "kill" or CurrentAction == "autokill" do
                local live = nil
                for _, p in ipairs(TargetList) do
                    if p and getChar(p) and not isKO(getChar(p)) then
                        live = p
                        break
                    end
                end
                if not live then
                    -- all down: stomp then wait / stop
                    if StompOnKill and (MySlot == 1 or MySlot == StompBotSlot) then
                        for _, p in ipairs(TargetList) do
                            pcall(function() doStomp(p) end)
                            task.wait(0.08)
                        end
                    end
                    if not isAuto then
                        stopAll()
                        break
                    end
                    task.wait(0.4)
                else
                    TargetPlayer = live
                    local my = getRoot(LocalPlayer.Character)
                    local ctrl = getController()
                    local cr = getRoot(getChar(ctrl))
                    -- 1) teleport to controller
                    if my and cr then
                        my.CFrame = cr.CFrame * CFrame.new(0, 2, 2)
                        my.AssemblyLinearVelocity = Vector3.zero
                    end
                    task.wait(0.08)
                    -- 2) wait until forcefield off
                    local waited = 0
                    while getChar(live) and hasForceField(getChar(live)) and waited < 5 do
                        task.wait(0.1)
                        waited = waited + 0.1
                        if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then break end
                    end
                    if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then break end
                    -- 3) teleport to target and shoot until KO
                    local t0 = tick()
                    while getChar(live) and not isKO(getChar(live)) and tick() - t0 < 8 do
                        if hasForceField(getChar(live)) then
                            task.wait(0.1)
                        else
                            local tr = getRoot(getChar(live))
                            my = getRoot(LocalPlayer.Character)
                            if my and tr then
                                my.CFrame = tr.CFrame * CFrame.new(0, 2, 3)
                                my.AssemblyLinearVelocity = Vector3.zero
                                my.CanCollide = false
                            end
                            equipSelectedGuns()
                            shootTarget(live)
                        end
                        task.wait(0.05)
                        if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then break end
                    end
                    -- 4) stomp
                    if StompOnKill and (MySlot == 1 or MySlot == StompBotSlot) then
                        pcall(function() doStomp(live) end)
                    end
                    -- 5) teleport back to controller
                    my = getRoot(LocalPlayer.Character)
                    cr = getRoot(getChar(getController()))
                    if my and cr then
                        my.CFrame = cr.CFrame * CFrame.new(0, 2, 2)
                        my.AssemblyLinearVelocity = Vector3.zero
                    end
                    task.wait(0.12)
                end
            end
        end)
        return
    end

    startGlue(KillMethod == "knifekill" and "knife" or "gun", TargetPlayer)
    local stompIdx = 1

    ActionConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then return end
        refreshChar()
        -- find next living target
        local live = nil
        for _, p in ipairs(TargetList) do
            if p and not isKO(getChar(p)) and getChar(p) then
                live = p
                break
            end
        end
        if live then
            TargetPlayer = live
            killStep(live)
        else
            -- all down -> stomp all (slot 1)
            if StompOnKill and (MySlot == 1 or MySlot == StompBotSlot) then
                for _, p in ipairs(TargetList) do
                    pcall(function() doStomp(p) end)
                    task.wait(0.1)
                end
            end
            if isAuto then
                -- wait for respawn then continue
                task.wait(0.5)
            else
                stopAll()
                local ctrl = getController()
                if ctrl then
                    CurrentAction = "follow"
                    startFollow(ctrl)
                end
            end
        end
    end)
end

