                        kb.binding = true
                        kb_button.Text = "..."
                        kb_button.TextColor3 = Color3.fromRGB(170, 85, 235)
                        kb.connection = utility:Connection({Type = uis.InputBegan, Callback = function(input, gpe)
                            if gpe then return end
                            local key = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType
                            kb.key = key
                            kb.active = false
                            kb.binding = false
