local function toolMatches(tool, key)
    if not tool or not tool:IsA("Tool") then return false end
    local n = tool.Name:lower()
    local info = GUN_MAP[key]
    if not info then return n:find(key, 1, true) ~= nil end
    for _, frag in ipairs(info.tools) do
        if n:find(frag, 1, true) then return true end
    end
    return false
end

local function findTool(key, parent)
    if not parent then return nil end
    for _, t in ipairs(parent:GetChildren()) do
        if toolMatches(t, key) then return t end
    end
    return nil
end

local function hasGun(key)
    local bag = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    return (findTool(key, bag) ~= nil) or (findTool(key, char) ~= nil)
end

local function findClickDetector(obj)
    if not obj then return nil end
    local d = obj:FindFirstChildOfClass("ClickDetector") or obj:FindFirstChild("ClickDetector")
    if d then return d end
    for _, c in ipairs(obj:GetDescendants()) do
        if c:IsA("ClickDetector") then return c end
    end
    return nil
end

local function findShopPart(item)
    if not item then return nil end
    return item:FindFirstChild("Head")
        or item:FindFirstChild("ClickDetector") and item:FindFirstChild("ClickDetector").Parent
        or item:FindFirstChildWhichIsA("BasePart")
end

-- Da Hood shop: TP on top of item and spam fireclickdetector (max distance)
local function fireShopClick(det)
    if not det then return end
    -- common executor APIs
    pcall(function() fireclickdetector(det) end)
    pcall(function() fireclickdetector(det, 0) end)
    pcall(function() fireclickdetector(det, 10) end)
    pcall(function() fireclickdetector(det, 100) end)
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(det.MouseClick)) do
                pcall(function() c:Fire(LocalPlayer) end)
                pcall(function() c.Function(LocalPlayer) end)
            end
        end
    end)
end

local function shopBuyItem(item, checkFn, tries)
    tries = tries or 12
    local root = getRoot(LocalPlayer.Character)
    if not item or not root then return false end
    local head = findShopPart(item)
    local det = findClickDetector(item)
    if not head then return false end
    local origin = root.CFrame
    for i = 1, tries do
        if checkFn and checkFn() then break end
        root = getRoot(LocalPlayer.Character)
        if not root then break end
        -- stand inside / on the shop part
        root.CFrame = CFrame.new(head.Position + Vector3.new(0, 2.5, 0))
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.08)
        if det then fireShopClick(det) end
        -- also try clicking any detector under shop folder nearby
        task.wait(0.08)
    end
    root = getRoot(LocalPlayer.Character)
    if root then
        root.CFrame = origin
        root.AssemblyLinearVelocity = Vector3.zero
    end
    return checkFn and checkFn() or false
end

local function findShopItemByName(frags)
    local ignored = Workspace:FindFirstChild("Ignored")
    local shop = ignored and ignored:FindFirstChild("Shop")
    if not shop then return nil end
    for _, ch in ipairs(shop:GetChildren()) do
        local n = ch.Name:lower()
        for _, f in ipairs(frags) do
            if n:find(tostring(f):lower():gsub("[%[%]]", ""), 1, true) then
                return ch
            end
        end
    end
    return nil
end

local function buyGun(key)
    local info = GUN_MAP[key]
    if not info then return false end
    if hasGun(key) then return true end
    local frags = {}
    if info.shop then frags[#frags + 1] = info.shop end
    for _, f in ipairs(info.tools) do frags[#frags + 1] = f end
    local item = findShopItemByName(frags)
    if not item then return false end
    return shopBuyItem(item, function() return hasGun(key) end, 15)
end

local function buyArmor()
    local char = LocalPlayer.Character
    local be = char and char:FindFirstChild("BodyEffects")
    local armor = be and be:FindFirstChild("Armor")
    if not armor then return false end
    if armor.Value >= 100 then return true end
    local item = findShopItemByName({ "medium armor", "[medium armor]", "armor" })
    -- prefer exact medium armor $1000
    local ignored = Workspace:FindFirstChild("Ignored")
    local shop = ignored and ignored:FindFirstChild("Shop")
    if shop then
        item = shop:FindFirstChild("[Medium Armor] - $1000")
            or shop:FindFirstChild("[Medium Armor]")
            or item
    end
    if not item then return false end
    local before = armor.Value
    shopBuyItem(item, function()
        local a = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("BodyEffects")
            and LocalPlayer.Character.BodyEffects:FindFirstChild("Armor")
        return a and a.Value > before
    end, 15)
    local a = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("BodyEffects")
        and LocalPlayer.Character.BodyEffects:FindFirstChild("Armor")
    return a and a.Value > before
end

local function findAmmoShopItem(key)
    -- ONLY ammo for this gun key (never fall back to revolver/other)
    key = tostring(key or ""):lower()
    local info = GUN_MAP[key]
    if not info then return nil end
    local ignored = Workspace:FindFirstChild("Ignored")
    local shop = ignored and ignored:FindFirstChild("Shop")
    if not shop then return nil end

    local must = {}
    if info.ammo then
        for _, a in ipairs(info.ammo) do
            must[#must + 1] = tostring(a):lower():gsub("[%[%]]", "")
        end
    end
    if info.shop then
        local base = info.shop:lower():gsub("[%[%]]", "")
        must[#must + 1] = base .. " ammo"
    end
    for _, frag in ipairs(info.tools or {}) do
        must[#must + 1] = tostring(frag):lower() .. " ammo"
    end

    -- Primary: shop name contains ammo + this gun's keyword
    for _, ch in ipairs(shop:GetChildren()) do
        local n = ch.Name:lower()
        if not n:find("ammo", 1, true) then
            -- not ammo
        else
            for _, m in ipairs(must) do
                if m ~= "" and n:find(m, 1, true) then
                    return ch
                end
            end
            -- gun keyword + "ammo" in name (e.g. "[Rifle Ammo] - $xx")
            for _, frag in ipairs(info.tools or {}) do
                local f = tostring(frag):lower()
                if f ~= "" and n:find(f, 1, true) then
                    return ch
                end
            end
        end
    end
    return nil -- do NOT buy unrelated ammo
end

local function getToolAmmoCount()
    local char = LocalPlayer.Character
    local bag = LocalPlayer:FindFirstChild("Backpack")
    local best = nil
    for _, parent in ipairs({ char, bag }) do
        if parent then
            for _, tool in ipairs(parent:GetChildren()) do
                if tool:IsA("Tool") and not tool.Name:lower():find("knife") then
                    local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AMMO")
                        or tool:FindFirstChild("MaxAmmo")
                    if ammo and typeof(ammo.Value) == "number" then
                        return ammo.Value, tool
                    end
                    -- nested
                    for _, d in ipairs(tool:GetDescendants()) do
                        if d.Name:lower() == "ammo" and d:IsA("ValueBase") then
                            return d.Value, tool
                        end
                    end
                end
            end
        end
    end
    return nil, nil
end

local function buyAmmoClicks(key, clicks)
    if not AutoBuyAmmo then return false end
    clicks = math.max(1, math.floor(clicks or 10))
    key = tostring(key or ""):lower()
    -- only selected guns; default to first selected, never force revolver
    if key == "" or not GUN_MAP[key] then
        key = SelectedGuns[1]
    end
    if not key or not GUN_MAP[key] then return false end
    local item = findAmmoShopItem(key)
    if not item then return false end -- no wrong-gun ammo
    local root = getRoot(LocalPlayer.Character)
    if not root then return false end
    local head = findShopPart(item)
    local det = findClickDetector(item)
    if not head then return false end
    local origin = root.CFrame
    for i = 1, clicks do
        root = getRoot(LocalPlayer.Character)
        if not root then break end
        root.CFrame = CFrame.new(head.Position + Vector3.new(0, 2.5, 0))
        root.AssemblyLinearVelocity = Vector3.zero
        if det then fireShopClick(det) end
        task.wait(0.05)
    end
    root = getRoot(LocalPlayer.Character)
    if root then
        root.CFrame = origin
        root.AssemblyLinearVelocity = Vector3.zero
    end
    return true
end

local function ensureGuns()
    for _, key in ipairs(SelectedGuns) do
        if not hasGun(key) and AutoBuyGuns then
            local ok = false
            pcall(function() ok = buyGun(key) end)
            task.wait(0.15)
            -- after buying a gun, buy bullets 30 times
            if hasGun(key) then
                pcall(function() buyAmmoClicks(key, AMMO_AFTER_GUN_CLICKS) end)
            end
            task.wait(0.1)
        end
    end
end

