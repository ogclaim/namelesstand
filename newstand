dzDestroyRig = function()
    if dzRig.conn then dzRig.conn:Disconnect(); dzRig.conn = nil end
    if dzRig.folder then dzRig.folder:Destroy(); dzRig.folder = nil end
    dzRig.parts = {}
end

dzCreateRig = function()
    dzDestroyRig()
    local char = localPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local folder = Instance.new("Folder")
    folder.Name = "MiniDesyncRig"
    folder.Parent = workspace
    dzRig.folder = folder
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            local ghost = Instance.new("Part")
            ghost.Size = p.Size; ghost.Anchored = true; ghost.CanCollide = false; ghost.CastShadow = false
            ghost.Material = Enum.Material.Neon; ghost.Color = HV.rigColor; ghost.Transparency = HV.rigTransparency
            ghost.TopSurface = Enum.SurfaceType.Smooth; ghost.BottomSurface = Enum.SurfaceType.Smooth
            ghost.Parent = folder
            dzRig.parts[p] = {part = ghost, offset = root.CFrame:Inverse() * p.CFrame}
        end
    end
    dzRig.conn = RunService.RenderStepped:Connect(function()
        local targetCF = dzState.target_position
        for realPart, data in pairs(dzRig.parts) do
            if not realPart.Parent or not data.part or not data.part.Parent then
                dzRig.parts[realPart] = nil
            else
                if targetCF then data.part.CFrame = targetCF * data.offset end
                data.part.Color = HV.rigColor
                data.part.Transparency = HV.rigOn and HV.rigTransparency or 1
            end
        end
    end)
end

