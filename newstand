local function wonder()
    stopAll()
    CurrentAction = "wonder"
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "wonder" or not Root or not Humanoid then return end
        if tick() % 3 < 0.05 then
            local p = Root.Position + Vector3.new(math.random(-40, 40), 0, math.random(-40, 40))
            Humanoid:MoveTo(p)
        end
    end)
end

local function fwonder()
    stopAll()
    CurrentAction = "fwonder"
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "fwonder" then return end
        local tr = getRoot(resolvePlayer())
        if not tr or not Humanoid then return end
        if tick() % 2 < 0.05 then
            local p = tr.Position + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
            Humanoid:MoveTo(p)
        end
    end)
end

local function gotoPlayer(name)
    local target = resolvePlayer(name)
    if not target then return end
    local tr = getRoot(target)
    if tr and Root then Root.CFrame = tr.CFrame * CFrame.new(0, 2, 3) end
end

local function bringToController(name)
    local target = resolvePlayer(name)
    local ctrl = resolvePlayer()
    if not target or not ctrl then return end
    local tr, cr = getRoot(target), getRoot(ctrl)
    if tr and Root then Root.CFrame = tr.CFrame end
    task.wait(0.2)
    if cr and Root then Root.CFrame = cr.CFrame * CFrame.new(0, 2, 0) end
end

local function fling(name, mode)
    local target = resolvePlayer(name)
    if not target then return end
    stopAll()
    CurrentAction = "fling"
    TargetPlayer = target
    local t0 = tick()
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "fling" then return end
        local tr = getRoot(TargetPlayer)
        if not tr or not Root then return end
        local ang = (tick() - t0) * 20
        if mode == 2 then
            Root.CFrame = tr.CFrame * CFrame.new(0, math.sin(ang) * 8, 0)
        else
            Root.CFrame = tr.CFrame * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, 2)
        end
        Root.AssemblyLinearVelocity = Vector3.new(math.cos(ang) * 80, 40, math.sin(ang) * 80)
    end)
end

local function nuke(name)
    local target = resolvePlayer(name)
    if not target then return end
    stopAll()
    local tr = getRoot(target)
    if not tr or not Root then return end
    Root.CFrame = tr.CFrame * CFrame.new(0, 80, 0)
    task.wait(0.15)
    Root.AssemblyLinearVelocity = Vector3.new(0, -200, 0)
    task.delay(0.5, function()
        pcall(function()
            if Humanoid then Humanoid.Health = 0 end
        end)
    end)
end

local function firework()
    stopAll()
    if not Root then return end
    Root.AssemblyLinearVelocity = Vector3.new(0, 150, 0)
    task.delay(0.8, function()
        pcall(function() if Humanoid then Humanoid.Health = 0 end end)
    end)
end

local function sit()
    pcall(function() if Humanoid then Humanoid.Sit = true end end)
end

local function jump()
    pcall(function() if Humanoid then Humanoid.Jump = true end end)
end

local function softReset()
    pcall(function()
        if Character then Character:BreakJoints() end
    end)
end

local function hardReset()
    pcall(function()
        if Character then Character:Destroy() end
        if LocalPlayer.Character then LocalPlayer.Character = nil end
    end)
    pcall(function()
        local me = ReplicatedStorage:FindFirstChild("MainEvent")
        if me then me:FireServer("ResetNew") end
    end)
end

local function quitGame()
    pcall(function() game:Shutdown() end)
    pcall(function() LocalPlayer:Kick("Stand quit") end)
end

local function startNPC()
    stopAll()
    NPCMode = true
    CurrentAction = "npc"
    FollowConn = RunService.Heartbeat:Connect(function()
        if not NPCMode or not Humanoid or not Root then return end
        if tick() % 4 < 0.05 then
            Humanoid:MoveTo(Root.Position + Vector3.new(math.random(-15, 15), 0, math.random(-15, 15)))
        end
    end)
end

local function startMine(targetName)
    stopAll()
    MineMode = true
    CurrentAction = "mine"
    TargetPlayer = resolvePlayer(targetName) -- optional focus
    FollowConn = RunService.Heartbeat:Connect(function()
        if not MineMode or not Root then return end
        -- sit still; if anyone's head near us, "explode"
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head and (head.Position - Root.Position).Magnitude < 3.5 then
                    Root.AssemblyLinearVelocity = Vector3.new(0, 120, 0)
                    task.delay(0.2, function()
                        pcall(function() if Humanoid then Humanoid.Health = 0 end end)
                    end)
                    MineMode = false
                    break
                end
            end
        end
    end)
end

-- ========== COMMAND HANDLER ==========
local function isController(plr)
    return plr and (plr.Name == ControllerName or plr.Name:lower() == tostring(ControllerName):lower())
end

local function onChat(plr, msg)
    if not ChatCmdsEnabled then return end
    if not isController(plr) then return end
    msg = tostring(msg or ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    if msg:sub(1, #CommandPrefix) ~= CommandPrefix then return end
    local body = msg:sub(#CommandPrefix + 1)
    local args = {}
    for w in body:gmatch("%S+") do args[#args + 1] = w end
    local cmd = args[1] and args[1]:lower() or ""
    local a2 = args[2]
    local a3 = args[3]

    -- poses
    if cmd == "dog" then startPose("dog", a2)
    elseif cmd == "bodyguard" or cmd == "bg" then startPose("bodyguard", a2)
    elseif cmd == "dih" or cmd == "gun" or cmd == "gunpose" then startPose("dih", a2)
    elseif cmd == "benx" then startPose("benx", a2)
    elseif cmd == "blow" or cmd == "bj" or cmd == "head" then startPose("blow", a2)
    elseif cmd == "doggy" or cmd == "puppy" then startPose("doggy", a2)
    elseif cmd == "hug" then startPose("hug", a2)
    elseif cmd == "tank" then startPose("tank", a2)

    -- core
    elseif cmd == "summon" or cmd == "s" then startFollow(nil)
    elseif cmd == "vanish" or cmd == "v" then vanish()
    elseif cmd == "follow" or cmd == "frame" then startFollow(a2)
    elseif cmd == "stop" then stopAll()
    elseif cmd == "help" or cmd == "cmds" or cmd == "commands" then
        say("NAMELESS fun stand — poses/formations/orbit. !summon !stop !weld on/off")
    elseif cmd == "chatcmd" then
        ChatCmdsEnabled = not ChatCmdsEnabled
    elseif cmd == "weld" or cmd == "usewelding" or cmd == "targetweld" then
        if a2 == "off" then WeldEnabled = false stopGlue()
        elseif a2 == "on" then WeldEnabled = true
        else WeldEnabled = not WeldEnabled if not WeldEnabled then stopGlue() end end
    elseif cmd == "multistand" or cmd == "multi" or cmd == "multipos" or cmd == "multianim" then
        if a2 == "off" then MultiStand = false
        elseif a2 == "on" then MultiStand = true
        else MultiStand = not MultiStand end
    elseif cmd == "mutesound" or cmd == "mute" or cmd == "mutestand" then
        MuteSound = not MuteSound
    elseif cmd == "say" or cmd == "chat" then
        local m = table.concat(args, " ", 2)
        if m ~= "" then say(m) end

    -- formations / advanced
    elseif cmd == "elevator" then startFormation("elevator", a2)
    elseif cmd == "npc" then startNPC()
    elseif cmd == "unnpc" then NPCMode = false stopAll()
    elseif cmd == "mine" then startMine(a2)
    elseif cmd == "sit" then sit()
    elseif cmd == "jump" then jump()
    elseif cmd == "re" then softReset()
    elseif cmd == "forcereset" then hardReset()
    elseif cmd == "quit" then quitGame()
    elseif cmd == "firework" then firework()
    elseif cmd == "nuke" then if a2 then nuke(a2) end
    elseif cmd == "fling" then if a2 then fling(a2, 1) end
    elseif cmd == "fling2" then if a2 then fling(a2, 2) end

    elseif cmd == "pf" then pathfindTo(a2)
    elseif cmd == "walkto" then walkTo(a2)
    elseif cmd == "wonder" then wonder()
    elseif cmd == "fwonder" then fwonder()
    elseif cmd == "stalk" then stalk(a2)
    elseif cmd == "swarm" then startFormation("swarm", a2)
    elseif cmd == "swarm2" then startFormation("swarm2", a2)
    elseif cmd == "worm" then startFormation("worm", a2)
    elseif cmd == "rline" then startFormation("rline", a2)
    elseif cmd == "lline" then startFormation("lline", a2)
    elseif cmd == "bline" then startFormation("bline", a2)
    elseif cmd == "circle" then startFormation("circle", a2)
    elseif cmd == "stackon" then startFormation("stackon", a2)
    elseif cmd == "bring" then bringToController(a2)
    elseif cmd == "goto" then if a2 then gotoPlayer(a2) end

    elseif cmd == "orbit" then startOrbit("orbit", a2)
    elseif cmd == "orbit2" then startOrbit("orbit2", a2)
    elseif cmd == "orbit3" then startOrbit("orbit3", a2)
