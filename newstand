function F.BotChat(msg)
    pcall(function()
        local TCS = game:GetService("TextChatService")
        local ch = TCS and TCS:FindFirstChild("TextChannels") and TCS.TextChannels:FindFirstChild("RBXGeneral")
        if ch and ch.SendAsync then ch:SendAsync(tostring(msg)) return end
    end)
    pcall(function()
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local say = ev and ev:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(tostring(msg), "All") end
