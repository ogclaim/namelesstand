end

getgenv().NAMELESS_LITE_UNLOAD = function()
    F.StopAll()
    F.StopKillAura()
    OptMode = false
end


local AnnounceLoaded = function()
    local msg = "Stand loaded successfully!"
    pcall(function()
        local TCS = game:GetService("TextChatService")
        local ch = TCS and TCS:FindFirstChild("TextChannels") and TCS.TextChannels:FindFirstChild("RBXGeneral")
        if ch and ch.SendAsync then
            ch:SendAsync(msg)
            return
        end
    end)
    pcall(function()
        local ev = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        local say = ev and ev:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(msg, "All") end
    end)
end
task.defer(AnnounceLoaded)
task.defer(function()
    task.wait(1)
    pcall(function() if F.IsStandClient and F.IsStandClient() and F.StartDefaultEmote then F.StartDefaultEmote() end end)
end)

print("[NAMELESS LITE] loaded")
