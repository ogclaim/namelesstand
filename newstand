    bring=true, b=true, say=true, help=true, cmds=true,
}

local function parseArgs(msg)
    msg = tostring(msg or ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    if msg == "" then return nil end
    local body = nil
    local c1 = msg:sub(1, 1)
    if c1 == "!" or c1 == "." then
        body = msg:sub(2)
    else
        local lower = msg:lower()
        local a, b = lower:find("nameless%.hvh%s*|%s*!")
        if a == 1 then
            body = msg:sub(b + 1)
        else
            -- no prefix: "k user" / "teleport" / "ak name"
            local first = lower:match("^(%S+)")
            if first and KNOWN_CMDS[first] then
                body = msg
            end
        end
    end
    if not body then return nil end
    body = body:match("^%s*(.-)%s*$") or body
    local args = {}
    for w in body:gmatch("%S+") do args[#args + 1] = w end
    return args
end

local function onChat(player, message)
    if not isOwner(player) then return end
    local args = parseArgs(message)
    if not args or not args[1] then return end
    local cmd = args[1]:lower()
    local a2 = args[2]
    local a3 = args[3]

    local function collectTargets(startIdx)
        local list = {}
        for i = startIdx or 2, #args do
            for part in tostring(args[i]):gmatch("[^,]+") do
                local p = findPlayer(part)
                if p then list[#list + 1] = p end
            end
        end
        return list
    end

    -- KILL
    if cmd == "kill" or cmd == "k" then
        local t = collectTargets(2)
        if #t > 0 then startKill(t, false, KillMethod) end
    elseif cmd == "autokill" or cmd == "ak" or cmd == "a" then
        local t = collectTargets(2)
        if #t > 0 then startKill(t, true, KillMethod) end
    elseif cmd == "orbitkill" then
        KillMethod = "orbitkill"
        local t = collectTargets(2)
        if #t > 0 then startKill(t, true, "orbitkill") end
    elseif cmd == "skykill" then
        KillMethod = "skykill"
        local t = collectTargets(2)
        if #t > 0 then startKill(t, true, "skykill") end
    elseif cmd == "standkill" then
        KillMethod = "standkill"
        local t = collectTargets(2)
        if #t > 0 then startKill(t, true, "standkill") end
    elseif cmd == "knifekill" then
        KillMethod = "knifekill"
        local t = collectTargets(2)
        if #t > 0 then startKill(t, false, "knifekill") end
    elseif cmd == "stkill" or cmd == "spamtteleportkill" or cmd == "spamtpreleportkill" or cmd == "stk" then
        KillMethod = "stkill"
        local t = collectTargets(2)
        if #t > 0 then startKill(t, true, "stkill") end
    elseif cmd == "gun" then
        UseKnife = false
        equipSelectedGuns()
    elseif cmd == "knife" then
        UseKnife = true
        equipKnife()
    elseif cmd == "stop" or cmd == "idle" then
        stopAll()
    elseif cmd == "stomp" then
        if a2 == "off" then StompOnKill = false
        elseif a2 == "on" then StompOnKill = true
        else StompOnKill = not StompOnKill end

    -- FORMATIONS / TELEPORT (no glue - CFrame only)
    elseif cmd == "teleport" or cmd == "tp" or cmd == "summon" or cmd == "follow" or cmd == "come" then
        -- !teleport = TP + hold position on controller (CFrame), not glue
        startFollow(getController())
    elseif cmd == "return" then
        startFollow(getController())
    elseif cmd == "around" then startFormation("around", a2)
    elseif cmd == "back" then startFormation("back", a2)
    elseif cmd == "bline" then startFormation("bline", a2)
    elseif cmd == "line" then startFormation("line", a2)
    elseif cmd == "orbit" and not a2 then startFormation("orbit", nil)
    elseif cmd == "orbit" and a2 then startFormation("orbit", a2)
    elseif cmd == "s" then tpToController()
    elseif cmd == "safe" then safeSpot()
    elseif cmd == "ownerpos" or cmd == "powner" then
        CurrentAction = "ownerpos"
        FollowConn = RunService.Heartbeat:Connect(function()
            if CurrentAction ~= "ownerpos" then return end
            local tr = getRoot(getChar(getController()))
            local my = getRoot(LocalPlayer.Character)
            if tr and my then my.CFrame = tr.CFrame end
        end)
    elseif cmd == "unownerpos" then stopAll()

    -- GUNS
    elseif cmd == "rifle" or cmd == "db" or cmd == "rev" or cmd == "silencer"
        or cmd == "lmg" or cmd == "aug" or cmd == "flintlock" then
        -- multi select: !rifle !db keeps both if we append
        local key = cmd
        if cmd == "rev" then key = "rev" end
        local found = false
        for _, g in ipairs(SelectedGuns) do if g == key then found = true break end end
        if not found then SelectedGuns[#SelectedGuns + 1] = key end
        -- if only setting one primary, user can !gun first - for simplicity set as list
        ensureGuns()
        equipSelectedGuns()
    elseif cmd == "guns" and a2 then
        -- !guns rifle,db,lmg
        SelectedGuns = {}
        for part in tostring(a2):gmatch("[^,]+") do
            part = part:lower():match("^%s*(.-)%s*$")
            if GUN_MAP[part] then SelectedGuns[#SelectedGuns + 1] = part end
        end
        if #SelectedGuns == 0 then SelectedGuns = { "rifle" } end
        ensureGuns()
        equipSelectedGuns()

    -- TOGGLES
    elseif cmd == "autostomp" then
        if a2 == "off" then AutoStompEnabled = false
        elseif a2 == "on" then AutoStompEnabled = true
        else AutoStompEnabled = not AutoStompEnabled end
    elseif cmd == "spinbot" or cmd == "spin" then
        if a2 and tonumber(a2) then SpinbotSpeed = tonumber(a2) SpinbotEnabled = true
        else SpinbotEnabled = not SpinbotEnabled end
    elseif cmd == "hold" or cmd == "ghold" then HoldMode = "gun" equipSelectedGuns()
    elseif cmd == "khold" then HoldMode = "knife" equipKnife()
    elseif cmd == "unhold" then HoldMode = nil
    elseif cmd == "dance" then
        if a2 == "off" then stopDance()
        else playDance(a2 or "aura") end
    elseif cmd == "reset" or cmd == "r" then
        pcall(function()
            local h = getHum(LocalPlayer.Character)
            if h then h.Health = 0 end
        end)
    elseif cmd == "leave" or cmd == "l" then
        pcall(function() game:Shutdown() end)
        pcall(function() LocalPlayer:Kick("Stand left") end)
    elseif cmd == "slot" and a2 and tonumber(a2) then
        MySlot = math.clamp(math.floor(tonumber(a2)), 1, MaxBots)
    elseif cmd == "rows" and a2 and tonumber(a2) then
        FormationRows = math.max(1, math.floor(tonumber(a2)))
    elseif cmd == "perrow" and a2 and tonumber(a2) then
        FormationPerRow = math.max(1, math.floor(tonumber(a2)))
    elseif cmd == "load" then
        -- no GUI by design
        botSay("Nameless DH stand: chat only (no GUI)")

    -- OWNERSHIP
    elseif cmd == "transfer" and a2 then
        local p = findPlayer(a2)
        if p then ControllerName = p.Name end
    elseif cmd == "reclaim" or cmd == "revert" or cmd == "returnowner" then
        if player.Name:lower() == OriginalControllerName:lower() then
            ControllerName = OriginalControllerName
            ExtraOwners = {}
        end
    elseif cmd == "whitelist" or cmd == "wl" then
        if a2 then
            local p = findPlayer(a2)
            Whitelist[(p and p.Name or a2):lower()] = true
        end
    elseif cmd == "unwhitelist" or cmd == "unwl" then
        if a2 then
            local p = findPlayer(a2)
            Whitelist[(p and p.Name or a2):lower()] = nil
        end
    elseif cmd == "addowner" and a2 then
        local p = findPlayer(a2)
        if p then ExtraOwners[#ExtraOwners + 1] = p.Name end
    elseif cmd == "removeowner" and a2 then
        local n = a2:lower()
        local nn = {}
        for _, e in ipairs(ExtraOwners) do
            if e:lower() ~= n then nn[#nn + 1] = e end
        end
        ExtraOwners = nn
    elseif cmd == "bot" or cmd == "unbot" then
        -- reserved
    elseif cmd == "bring" or cmd == "b" then
        if a2 then startBring(a2) end
    elseif cmd == "say" then
        local text = table.concat(args, " ", 2)
        if text ~= "" then botSay(text) end
    elseif cmd == "help" or cmd == "cmds" then
        botSay("Nameless DH: !summon !ak !skykill !orbitkill !standkill !knifekill !stop !dance")
    end
end

