        local L = game:GetService("Lighting")
        L.GlobalShadows = false
    end)
    task.spawn(function()
        while OptMode do
            local r = F.root()
            if r then
                local origin, range2 = r.Position, (OptCullRange or 50)^2
                for _, child in ipairs(workspace:GetChildren()) do
                    local isChar = false
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr.Character == child then isChar = true break end
                    end
                    if not isChar and not child:IsA("Terrain") then
                        local pp = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                        if pp then
                            local d2 = (pp.Position - origin).Magnitude
                            local hide = d2 * d2 > range2
                            if child:IsA("BasePart") then
                                child.LocalTransparencyModifier = hide and 1 or 0
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

F.FindPlayer = function(name)
    if not name then return nil end
    name = lower(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or p.DisplayName:lower() == name then return p end
        if p.Name:lower():sub(1, #name) == name then return p end
    end
    return nil
end

F.ParseTargets = function(args, startIdx)
    local out = {}
    for i = startIdx, #args do
        local p = F.FindPlayer(args[i])
        if p then out[#out + 1] = p end
    end
    return out
end

F.ParseBody = function(message)
    if not message then return nil end
    local raw = tostring(message):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    local lower = raw:lower()
    -- NAMELESS.HVH|:!cmd  (case-insensitive)
    local lowerMsg = lower
    local a, b = lowerMsg:find("nameless%.hvh%s*|%s*!")
    if a == 1 then
        return lowerMsg:sub(b + 1):match("^%s*(.-)%s*$")
    end
    if lowerMsg:sub(1, 14) == "nameless.hvh|!" then
        return lowerMsg:sub(15):match("^%s*(.-)%s*$")
    end
    -- legacy nameless:!
    if lower:sub(1, 10) == "nameless:!" then
        return raw:sub(11):match("^%s*(.-)%s*$")
    end
    -- plain !cmd
    if lower:sub(1, 1) == "!" then
        return raw:sub(2):match("^%s*(.-)%s*$")
    end
    return nil
end

F.OnChatted = function(player, message)
    if not player or not F.IsOwner(player) then return end
    -- Only stands execute stand actions (controller chat is the signal)
    if F.IsControllerClient() then return end
    local body = F.ParseBody(message)
    if not body or body == "" then return end
    body = body:lower()
    local args = {}
    for w in body:gmatch("%S+") do args[#args + 1] = w end
    local cmd = args[1]
    if not cmd then return end

    if cmd == "forcehit" or cmd == "fh" then
        local p = args[2] and F.FindPlayer and F.FindPlayer(args[2])
        ForceHitCmdTarget = p
        return
    elseif cmd == "unforcehit" or cmd == "ufh" then
        ForceHitCmdTarget = nil
        return
    elseif cmd == "safe" then
        local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if r then pcall(function() r.CFrame = CFrame.new(322.43, 34.99, -604.27) end) end
        return
    elseif cmd == "teleport" or cmd == "tpbots" then
        local ctrl = F.GetController and F.GetController()
        local cr = ctrl and ctrl.Character and ctrl.Character:FindFirstChild("HumanoidRootPart")
        local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if cr and r then
            local slot = MySlot or 1
            local ang = (slot - 1) * (math.pi * 2 / 8)
            pcall(function() r.CFrame = CFrame.new(cr.Position + Vector3.new(math.cos(ang)*4, 0, math.sin(ang)*4)) end)
        end
        return
    elseif cmd == "dance" then
        if args[2] == "off" or args[2] == "stop" then
            F.StartDefaultEmote()
        elseif args[2] and VAULT_EMOTES[args[2]] then
            F.PlayEmote(VAULT_EMOTES[args[2]])
        elseif args[2] and tonumber(args[2]) then
            F.PlayEmote("rbxassetid://" .. args[2])
        else
            F.PlayEmote(DefaultEmoteId)
        end
        return
    elseif cmd == "stop" or cmd == "idle" then
        ForceHitCmdTarget = nil

        F.StopAll()
        F.StopKillAura()
    elseif cmd == "return" or cmd == "summon" or cmd == "follow" or cmd == "come" then
        F.StopProtectOwner()
        F.StartFollow()
    elseif cmd == "around" then
        F.StartAround()
    elseif cmd == "orbit" then
        local a2 = args[2] and lower(args[2]) or ""
        local n = tonumber(args[2])
        if n == 2 or a2 == "2" then
            F.StartControllerOrbit(2)
        elseif n == 3 or a2 == "3" then
            F.StartControllerOrbit(3)
        elseif n == 1 or a2 == "1" or a2 == "" then
            -- !orbit or !orbit 1 = horizontal controller orbit
            F.StartControllerOrbit(1)
        elseif a2 == "top" or a2 == "bottom" or a2 == "back" or a2 == "front" or a2 == "left" or a2 == "right" then
            KillPosition = a2:sub(1,1):upper() .. a2:sub(2)
            KillMethod = "orbit"
            OrbitEnabled = true
        else
            F.StartControllerOrbit(1)
        end
    elseif cmd == "orbitkill" then
        KillMethod = "orbit"
        OrbitEnabled = true
    elseif cmd == "flymode" or cmd == "fly" then
        local m = args[2] and lower(args[2]) or ""
        local map = { hover = "Hover", glide = "Glide", fly = "Fly", heaven = "Heaven", gogo = "gogo" }
        if map[m] then FlyMode = map[m] end
    elseif cmd == "spinbot" or cmd == "spin" then
        local n = tonumber(args[2])
        if args[2] == "off" then
            SpinbotEnabled = false
        elseif n then
            SpinbotSpeed = math.clamp(n, 1, 200)
            SpinbotEnabled = true
        else
            SpinbotEnabled = not SpinbotEnabled
        end
    elseif cmd == "gunspamkill" or cmd == "gsk" then
        UseGun = true
        KillMethod = "spamvoid"
    elseif cmd == "knifespamkill" or cmd == "ksk" then
        UseGun = false
        KillMethod = "spamvoid"
    elseif cmd == "kill" or cmd == "k" then
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, false) end
    elseif cmd == "autokill" or cmd == "ak" or cmd == "a" then
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "aorbit" then
        KillMethod = "orbit"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "agsk" then
        UseGun = true
        KillMethod = "spamvoid"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "aksk" then
        UseGun = false
        KillMethod = "spamvoid"
        local t = F.ParseTargets(args, 2)
        if #t > 0 then F.StartKill(t, true) end
    elseif cmd == "ka" or cmd == "killaura" then
        local n = tonumber(args[2])
        if n then KillAuraRange = math.clamp(n, 5, 300) end
        if args[2] == "off" then F.StopKillAura()
        else F.StartKillAura() end
    elseif cmd == "opt" or cmd == "optimize" then
        if args[2] == "off" then OptMode = false
        else F.SetOptMode(true) end
    elseif cmd == "powner" or cmd == "protectowner" then
        F.StartProtectOwner()
    elseif cmd == "unpowner" or cmd == "unprotectowner" then
        F.StopProtectOwner()
    elseif cmd == "rapid" or cmd == "rapidfire" then
        if args[2] == "off" then RapidFireEnabled = false
        else RapidFireEnabled = true end
    elseif cmd == "transfer" then
        local p = F.FindPlayer(args[2])
        if p then
            ControllerName = p.Name
            ExtraOwners = {}
            Whitelist[p.Name:lower()] = true
            F.BotChat("controller -> " .. p.Name)
        end
    elseif cmd == "whitelist" or cmd == "wl" then
        local p = F.FindPlayer(args[2])
        if p then
            Whitelist[p.Name:lower()] = true
            F.BotChat("wl " .. p.Name)
        end
    elseif cmd == "ghold" or cmd == "hold" then
        HoldMode = "gun"
        UseGun = true
    elseif cmd == "khold" then
        HoldMode = "knife"
        UseGun = false
    elseif cmd == "uzi" or cmd == "rev" or cmd == "db" or cmd == "sg"
        or cmd == "tacticalsg" or cmd == "silencer" then
        F.SelectGun(cmd)
    elseif cmd == "gun" then UseGun = true
    elseif cmd == "knife" then UseGun = false
    elseif cmd == "blackscreen" or cmd == "bscreen" then
        if args[2] == "off" then F.SetBlackScreen(false)
        elseif args[2] == "on" then F.SetBlackScreen(true)
        else F.SetBlackScreen(BlackScreenGui == nil) end
    end
end

