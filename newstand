    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = hum and hum.RootPart
    if not root then library:Notification({text = "No rootpart", time = 2}); return end
    -- Snap to void at high velocity
    pcall(function()
        root:SetNetworkOwner(localPlayer)
        root.AssemblyLinearVelocity = Vector3.new(0, -9999, 0)
        root.CFrame = CFrame.new(root.Position.X, -500, root.Position.Z)
    end)
    -- Keep pushing down for 30 frames
    for i = 1, 30 do
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.new(0, -9999, 0)
            if sethiddenproperty then sethiddenproperty(root, "PhysicsRepRootPart", nil) end
        end)
        task.wait()
    end
    -- Wait for death/respawn
    local maxWait = tick() + 10
    while tick() < maxWait and root.Position.Y > -100 do
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, -9999, 0) end)
        task.wait()
    end
    task.wait(3)
    library:Notification({text = "Void hide complete", time = 2})
end})

