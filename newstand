-- ==== KNIFE GLUE SETTINGS (from larptic) ====
local KNIFE_ATTACH_POS = "HumanoidRootPart"
-- ==== SPACING MATH (no alt can hit another, target always hit) ====
-- Hitbox half-extents: 3 wide / 6 tall / 8 deep (+ the blade's own forward offset,
-- empirically ~7 studs: that is why the old 8^3 box clipped alts 14 studs away).
-- Ground alts sit KNIFE_DISTANCE (12) out -> diagonal neighbors are 17 apart with a
-- lateral component of 0.707*12 = 8.5 vs 4 (box) + 2.5 (body) = 6.5 reach -> 2+ clear.
-- Opposite alts are 24 apart vs 8 back + 15 forward reach -> 9+ clear.
-- Target: forward reach ~13-15 >= 12 - 2.5 to its body -> always connects.
-- Top alt: 8 above target, reaches 8+ down (covers it) but only 3-4 lateral;
-- ground alts are 12 out -> 5+ studs clear of the overhead alt in every axis.
local KNIFE_DISTANCE = 9  -- studs from target (formation radius)
-- CALCULATED MIN DISTANCE (why 9):
--   Expanded hitbox reaches ~15 studs forward (blade offset ~7 + half-depth 8).
--   MUST HIT TARGET:      D <= 15 - 2 (target body radius)          -> D <= 13
--   MUST NOT HIT OPPOSITE: 2D >= 15 (my reach) + 2 (his body)       -> D >= 8.5
--   MUST NOT HIT ADJACENT: lateral sep D*sqrt(2) >= 3+3 (boxes) +2+2 -> D >= 5.7
--   -> minimum safe D = 8.5, rounded to 9 (1+ stud spare on the tight axis).
-- CORNERS REMOVED: a diagonal slot lies EXACTLY on the cardinal alt's forward
-- box axis (dead center of its 15-deep reach) = guaranteed friendly fire.
-- Extra alts stack on the SECOND ROW (x2) instead: directly behind a cardinal,
-- outside every box (opposite reach ends 15 past center, second row sits 18).
local KNIFE_MAX_CONN = 100
local KNIFE_MIN_HEALTH = 0
-- Hitbox: DEEP (16) so it always reaches the target from KNIFE_DISTANCE,
-- TALL (12), NARROW (6) laterally.
local KNIFE_HITBOX_SIZE = Vector3.new(6, 12, 16)
-- FIXED slot per account (by UserId) so an alt NEVER takes another alt's spot,
-- no matter who is in the server: left / right / front / behind (+ 5th corner).
-- Spots rotate with the target's facing.
local KNIFE_SLOTS = {
    [11498491557] = {ox = 1,  oz = 0},   -- right
    [11425076899] = {ox = 0,  oz = 1},   -- front
    [3160591384]  = {ox = -1, oz = 0},   -- left
    [7858750955]  = {ox = 0,  oz = -1},  -- behind
}
local gfpWarned = false
-- Rank-based gang lanes - SAME slot system as Surround Owner, so the box is
-- always left/right/front/back (+ second row for extras) even if the hardcoded
-- per-account KNIFE_SLOTS keys ever drift from the real alt accounts.
local GANG_SLOTS = {
    { ox = -1, oz = 0 },   -- 1: left
    { ox = 1,  oz = 0 },   -- 2: right
    { ox = 0,  oz = 1 },   -- 3: front
    { ox = 0,  oz = -1 },  -- 4: back
    { ox = -2, oz = 0 },   -- 5: second-row far left
    { ox = 2,  oz = 0 },   -- 6: second-row far right
    { ox = 0,  oz = 2 },   -- 7: second-row far front
    { ox = 0,  oz = -2 },  -- 8: second-row far back
}
local function getFormationPos(targetPos, targetLook)
    local look = Vector3.new(targetLook.X, 0, targetLook.Z)
    local mag = look.Magnitude
    if mag < 0.01 then look = Vector3.new(0, 0, 1) else look = look / mag end
    local right = Vector3.new(-look.Z, 0, look.X)
    -- fixed per-account slot wins if configured; otherwise rank-based lane
    local spot = KNIFE_SLOTS[localPlayer.UserId] or GANG_SLOTS[getOwnAltRank()]
    if not spot then
        if not gfpWarned then
            gfpWarned = true
            warn("[STAND] no gang slot for " .. localPlayer.Name .. " - using far-behind fallback")
        end
        spot = {ox = 0, oz = -2}
    end
    return targetPos + look * (spot.oz * KNIFE_DISTANCE) + right * (spot.ox * KNIFE_DISTANCE)
end
