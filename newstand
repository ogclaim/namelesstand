local function laWallOk(part)
    if not LA.wallCheck then return true end
    if not part or not part.Parent then return false end
    local origin = Camera.CFrame.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {Camera}
    if localPlayer.Character then table.insert(filter, localPlayer.Character) end
    rp.FilterDescendantsInstances = filter
    local res = workspace:Raycast(origin, part.Position - origin, rp)
    if not res or not res.Instance then return true end
    return res.Instance:IsDescendantOf(part.Parent)
end

local function laClosest()
    local partName = LA.part

    if LA.sticky and laStickyTarget and laStickyTarget.Parent and laStickyTarget.Character and not fhIsKO(laStickyTarget) then
        local part = laStickyTarget.Character:FindFirstChild(partName)
        if part then
            local sp, vis = Camera:WorldToViewportPoint(part.Position)
            if vis and laWallOk(part) then
                return laStickyTarget, part
            end
        end
    end

    local mouse = UIS:GetMouseLocation()
    local radius = LA.radius
    local shortest, closest, closestPart = radius, nil, nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character then
            local part = plr.Character:FindFirstChild(partName)
            if part and not fhIsKO(plr) then
                local sp, vis = Camera:WorldToViewportPoint(part.Position)
                if vis then
                    local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if d < shortest and laWallOk(part) then
                        shortest, closest, closestPart = d, plr, part
                    end
                end
            end
        end
    end
    laStickyTarget = closest
    return closest, closestPart
end

