                        if kb.mode ~= "hold" then return end
                        local released = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType
                        if released == kb.key then
                            kb.active = false
                            kb_button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                            if kb.flag then library.flags[kb.flag] = {mode = kb.mode, key = kb.key, active = false} end
                            kb.callback(false)
                        end
                    end})
                    kb.set_visible = kb_set_visible
                    if kb.key and kb.key ~= Enum.KeyCode.Unknown then
                        if kb.flag then
                            library.flags[kb.flag] = {mode = kb.mode, key = kb.key, active = false}
                            library.config_flags[kb.flag] = function(v)
