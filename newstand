for _, p in ipairs(Players:GetPlayers()) do
    HookPlayerChat(p)
end
Players.PlayerAdded:Connect(function(p)
    HookPlayerChat(p)
    if BotSet[p.Name:lower()] then Whitelist[p.Name:lower()] = true end
end)
-- Modern chat
pcall(function()
    local TCS = game:GetService("TextChatService")
    if not TCS then return end
    TCS.MessageReceived:Connect(function(textMessage)
        if not textMessage then return end
        local src = textMessage.TextSource
        if not src then return end
        local plr = Players:GetPlayerByUserId(src.UserId)
        if plr then
            F.OnChatted(plr, textMessage.Text)
        end
    end)
end)
-- Debug: confirm stand identity
