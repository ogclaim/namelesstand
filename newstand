-- Local owner forcehit: fly behind target, spam Shoot, stomp when knocked, sky teleport on respawn
local ownerAutokillActive = false
local ownerAutokillTarget = nil
local ownerAutokillConn = nil
local ownerAutokillHighlight = nil
local ownerAutokillLastShot = 0
local ownerAutokillLastStomp = 0
local ownerAutokillTargetAlive = false
local AUTO_KILL_SPAM_RATE = 0.05
local AUTO_KILL_BURST = 5

local function removeOwnerAutokillHighlight()
    if ownerAutokillHighlight then
        pcall(function() ownerAutokillHighlight:Destroy() end)
        ownerAutokillHighlight = nil
    end
end

local function applyOwnerAutokillHighlight(char)
    removeOwnerAutokillHighlight()
    if not char then return end
    local hl = Instance.new("Highlight")
    hl.Name = "OwnerAutokillHighlight"
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.8
    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineTransparency = 0
    hl.Adornee = char
    hl.Parent = char
    ownerAutokillHighlight = hl
end

local function ownerAutokillSpawnTracer(startPos, endPos)
    local tracer = Instance.new("Part")
    tracer.Name = "OwnerAutokillTracer"
    tracer.Anchored = true
    tracer.CanCollide = false
    tracer.CanTouch = false
    tracer.CanQuery = false
    tracer.Material = Enum.Material.Neon
    tracer.Color = Color3.fromRGB(255, 30, 30)
    local distance = (startPos - endPos).Magnitude
    tracer.Size = Vector3.new(0.08, 0.08, distance)
    tracer.CFrame = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
    tracer.Parent = workspace
    local tween = TweenService:Create(tracer, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(0, 0, distance),
        Transparency = 1
    })
    tween.Completed:Connect(function() pcall(function() tracer:Destroy() end) end)
    tween:Play()
end

local function ownerAutokillIsKnocked(plr)
    local char = plr.Character
    local be = char and char:FindFirstChild("BodyEffects")
    local ko = be and be:FindFirstChild("K.O")
    return ko and ko.Value == true
end

local function ownerAutokillAutoEquip()
    local bp = localPlayer:FindFirstChildOfClass("Backpack")
    if bp and localPlayer.Character then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("shotgun") or tool.Name:lower():find("sg") or tool.Name:lower():find("double-barrel")) then
                tool.Parent = localPlayer.Character
                break
            end
        end
    end
end

local function ownerAutokillShouldFire(plr)
    local ff = plr.Character and plr.Character:FindFirstChildOfClass("ForceField")
    if not ff then return true end
    local now = workspace:GetServerTimeNow()
    local exp = ff:GetAttribute("ExpiresAt") or ff:GetAttribute("_ExpiresAt") or ff:GetAttribute("EndsAt") or ff:GetAttribute("EndTime") or ff:GetAttribute("ExpireTime")
    if not exp then
        local cr = ff:GetAttribute("Created") or ff:GetAttribute("SpawnTime") or ff:GetAttribute("TimeCreated") or ff:GetAttribute("StartTime")
        local du = ff:GetAttribute("Duration") or ff:GetAttribute("Lifetime") or ff:GetAttribute("MaxLifeTime") or ff:GetAttribute("Length")
        if cr and du then exp = cr + du end
    end
    if not exp then return false end
    return (exp - now) <= 0.05
end

local function ownerAutokillIsBlocked(origin, targetPart)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {localPlayer.Character, ownerAutokillTarget.Character}
    local hit = workspace:Raycast(origin, targetPart.Position - origin, params)
    return hit and hit.Instance and hit.Instance.CanCollide and not hit.Instance:IsDescendantOf(Players) and math.abs(hit.Normal.Y) < 0.5
end

local function ownerAutokillExecuteForceHit()
    if not ownerAutokillTarget or not ownerAutokillTarget.Parent then return false end
    local tChar = ownerAutokillTarget.Character
    if not tChar then return false end
    local tp = tChar:FindFirstChild("Head") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("HumanoidRootPart")
    if not tp then return false end
    local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    if not ownerAutokillShouldFire(ownerAutokillTarget) then return false end
    if ownerAutokillIsBlocked(myRoot.Position, tp) then return false end

    local payload = {{}, {}, myRoot.Position, myRoot.Position, workspace:GetServerTimeNow()}
    for i = 1, 5 do
        payload[1][i] = {Normal = tp.Position, Instance = tp, Position = tp.Position}
        payload[2][i] = {thePart = tp, theOffset = Vector3.zero}
    end

    if not ownerAutokillIsKnocked(ownerAutokillTarget) then
        ownerAutokillSpawnTracer(myRoot.Position, tp.Position)
    end

    pcall(function() MainEvent:FireServer("Shoot", payload) end)
    return true
end

local function ownerAutokillSkyTeleport()
    if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local root = localPlayer.Character.HumanoidRootPart
    local originalCF = root.CFrame
    local skyCF = CFrame.new(originalCF.Position.X, 500000000000, originalCF.Position.Z)

    local wasDeadEnabled = hum:GetStateEnabled(Enum.HumanoidStateType.Dead)
    local wasFallingDown = hum:GetStateEnabled(Enum.HumanoidStateType.FallingDown)
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

    local parts = {}
    for _, part in ipairs(localPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(parts, {part = part, anchored = part.Anchored})
            part.Anchored = true
        end
    end

    task.spawn(function()
        for i = 1, 100 do
            if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") or hum.Health <= 0 then break end
            localPlayer.Character:PivotTo(skyCF)
            root.CFrame = skyCF
            task.wait()
            if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") or hum.Health <= 0 then break end
            localPlayer.Character:PivotTo(originalCF)
            root.CFrame = originalCF
            task.wait()
        end
        for _, item in ipairs(parts) do
            if item.part and item.part.Parent then item.part.Anchored = item.anchored end
        end
        if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") and hum.Health > 0 then
            localPlayer.Character:PivotTo(originalCF)
            localPlayer.Character.HumanoidRootPart.CFrame = originalCF
            localPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            localPlayer.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        end
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, wasDeadEnabled)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, wasFallingDown)
    end)
end

local function startOwnerAutokill(target)
    if ownerAutokillActive then
        stopOwnerAutokill()
    end
    if not target or target == localPlayer then return end
    print("[STAND-AUTOKILL] Starting on", target.Name)

    ownerAutokillTarget = target
    ownerAutokillActive = true
    ownerAutokillTargetAlive = false
    ownerAutokillLastShot = 0
    ownerAutokillLastStomp = 0

    applyOwnerAutokillHighlight(target.Character)

    -- Ensure fly is active
    if not flyActive then
        startFly()
        task.wait(0.2)
    end

    ownerAutokillConn = RunService.Heartbeat:Connect(function()
        if not ownerAutokillActive then return end
        if not ownerAutokillTarget or not ownerAutokillTarget.Parent then
            stopOwnerAutokill()
            return
        end

        local tChar = ownerAutokillTarget.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        local myChar = localPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if not (tChar and tRoot and tHum and myChar and myRoot and myHum and myHum.Health > 0) then
            return
        end

        local isAlive = tHum.Health > 0

        if isAlive then
            ownerAutokillTargetAlive = true
        else
            if ownerAutokillTargetAlive then
                ownerAutokillTargetAlive = false
                -- Kill registered, sky teleport on respawn
                ownerAutokillSkyTeleport()
            end
        end

        if isAlive then
            if not ownerAutokillHighlight or ownerAutokillHighlight.Parent ~= tChar then
                applyOwnerAutokillHighlight(tChar)
            end

            ownerAutokillAutoEquip()

            local now = tick()
            local knocked = ownerAutokillIsKnocked(ownerAutokillTarget)

            if knocked then
                -- Stomp mode: position on top, spam Stomp
                local flatLook = Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
                if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
                myRoot.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 1.5, 0), tRoot.Position + Vector3.new(0, 1.5, 0) + flatLook)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
                if flyBV then flyBV.Velocity = Vector3.zero end
                if flyBG then flyBG.CFrame = CFrame.new(myRoot.Position, myRoot.Position + flatLook) end

                if now - ownerAutokillLastStomp >= 0.05 then
                    ownerAutokillLastStomp = now
                    pcall(function() MainEvent:FireServer("Stomp") end)
                end
            else
                -- Shoot mode: position behind, spam Shoot
                local behindCF = tRoot.CFrame * CFrame.new(0, 0, 3)
                myRoot.CFrame = behindCF
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
                if flyBV then flyBV.Velocity = Vector3.zero end
                if flyBG then flyBG.CFrame = behindCF end

                if now - ownerAutokillLastShot >= AUTO_KILL_SPAM_RATE then
                    ownerAutokillLastShot = now
                    for i = 1, AUTO_KILL_BURST do
                        ownerAutokillExecuteForceHit()
                    end
                end
            end
        end
    end)
end

local function stopOwnerAutokill()
    if not ownerAutokillActive then return end
    print("[STAND-AUTOKILL] Stopped")
    ownerAutokillActive = false
    ownerAutokillTarget = nil
    ownerAutokillTargetAlive = false
    if ownerAutokillConn then ownerAutokillConn:Disconnect(); ownerAutokillConn = nil end
    removeOwnerAutokillHighlight()
end

