    knifeReady = false
    -- Clear shared flags
    local shared = (getgenv and getgenv()) or _G
    shared.STAND_FORCEHIT_LIVE = false
    shared.STAND_DB_BATCH_AT = nil
    shared.STAND_DB_BATCH_N = nil
    shared.STAND_DB_LAST_ACT = nil
    shared.STAND_BRING_CANCEL = (shared.STAND_BRING_CANCEL or 0) + 1
end

-- ==== INIT ====
if not isOwner then
    task.spawn(initAlt)
end
localPlayer.CharacterAdded:Connect(function()
    if isOwner then return end
    local savedTarget = altTarget
    local savedMode = altMode
    -- HARD CLEANUP: kill everything from previous life before starting fresh
    cleanupAll()
    -- Restore target state (cleanupAll wipes altTarget/altMode)
    altTarget = savedTarget
    altMode = savedMode
    -- Clear PhysicsRepRootPart on NEW character immediately
    task.spawn(function()
        local newChar = localPlayer.Character
        if not newChar then return end
        local newHum = newChar:WaitForChild("Humanoid", 5)
        local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
        if newRoot and sethiddenproperty then
            pcall(function() sethiddenproperty(newRoot, "PhysicsRepRootPart", nil) end)
        end
        -- Disable collision on body parts only (exclude Head, Face, Hair, Accessories)
        task.wait(0.5)
        if newChar then
            for _, part in ipairs(newChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    local name = part.Name:lower()
                    -- Keep collision on Head, Face, Hair, Accessories for rendering
                    if not (name == "head" or name:find("face") or name:find("hair") or part:IsA("Accessory") or part:FindFirstAncestorWhichIsA("Accessory")) then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
    task.wait(1)
    if altTarget and altTarget.Parent and getCharacter(altTarget) then
        if altMode == "shoot" then
            startForceHit(altTarget)
        else
            startAttack(altTarget)
        end
    else
        startFollow()
    end
end)
-- ==== REGISTER STOP-ALL ====
-- The single-instance guard at the top of the file calls this when a newer copy of
-- the script loads (closures over this copy's own locals, so it disconnects exactly
-- this copy's loops + chat hooks and lets the fresh copy take over cleanly).
genv.STAND_API = {
    stopAll = function()
        pcall(stopAttack)
        pcall(stopSpectate)
        for _, c in ipairs(chatConns) do
            pcall(function() c:Disconnect() end)
        end
        for _, c in ipairs(spyConns) do
            pcall(function() c:Disconnect() end)
        end
    end,
}
