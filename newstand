local function getChar(plr)
    return plr and plr.Character
end
local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
end
local function getHum(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getController()
    if not ControllerName then return nil end
    local c = Players:FindFirstChild(ControllerName)
    if c then return c end
    local want = tostring(ControllerName):lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == want or (p.DisplayName and p.DisplayName:lower() == want) then
            return p
        end
    end
    return nil
end

local function isOwner(plr)
    if not plr then return false end
    local want = tostring(ControllerName or ""):lower()
    if plr.Name:lower() == want then return true end
    if plr.DisplayName and plr.DisplayName:lower() == want then return true end
    local o = tostring(OriginalControllerName or ""):lower()
    if o ~= "" and (plr.Name:lower() == o or (plr.DisplayName and plr.DisplayName:lower() == o)) then return true end
    for _, e in ipairs(ExtraOwners) do
        if plr.Name:lower() == tostring(e):lower() then return true end
    end
    return false
end

local function isWhitelisted(plr)
    if not plr then return false end
    if isOwner(plr) then return true end
    if BotList[plr.Name:lower()] then return true end
    if Whitelist[plr.Name:lower()] then return true end
    return false
end

local function findPlayer(name)
    if not name then return nil end
    name = tostring(name):lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or (p.DisplayName and p.DisplayName:lower() == name) then
            return p
        end
        if p.Name:lower():sub(1, #name) == name then return p end
    end
    return nil
end

local function isKO(char)
    if not char then return true end
    local hum = getHum(char)
    if hum and hum.Health <= 0 then return true end
    local be = char:FindFirstChild("BodyEffects")
    if be then
        local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
        if ko and ko.Value == true then return true end
        local dead = be:FindFirstChild("Dead")
        if dead and dead.Value == true then return true end
    end
    return false
end

local function hasForceField(char)
    return char and char:FindFirstChildOfClass("ForceField") ~= nil
end

local function unequipAll()
    local char = LocalPlayer.Character
    local bag = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bag then return end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then pcall(function() t.Parent = bag end) end
    end
end

local function safeEquip(tool)
    if not tool then return end
    local char = LocalPlayer.Character
    if not char then return end
    local cur = char:FindFirstChildOfClass("Tool")
    if cur == tool then return end
    unequipAll()
    local hum = getHum(char)
    pcall(function()
        if hum then hum:EquipTool(tool) else tool.Parent = char end
    end)
end

local function findTool(keys)
    local char = LocalPlayer.Character
    local bag = LocalPlayer:FindFirstChild("Backpack")
    for _, parent in ipairs({ char, bag }) do
        if parent then
            for _, t in ipairs(parent:GetChildren()) do
                if t:IsA("Tool") then
                    local n = t.Name:lower()
                    for _, k in ipairs(keys) do
                        if n:find(k:lower(), 1, true) then return t end
                    end
                end
            end
        end
    end
    return nil
end

local function equipSelected()
    if not UseGun then
        local knife = findTool({"knife"})
        if knife then safeEquip(knife) end
        return knife
    end
    local keys = GUN_KEYS[SelectedGun] or GUN_KEYS.rifle
    local tool = findTool(keys)
    if not tool then
        for _, keys2 in pairs(GUN_KEYS) do
            tool = findTool(keys2)
            if tool then break end
        end
    end
    if tool then safeEquip(tool) end
    return tool
end

local function shootTarget(target)
    refreshMainEvent()
    if not MainEvent or not target then return end
    local tChar = getChar(target)
    if not tChar or isKO(tChar) or hasForceField(tChar) then return end
    local head = tChar:FindFirstChild("Head") or getRoot(tChar)
    local my = getRoot(LocalPlayer.Character)
    if not head or not my then return end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool or tool.Name:lower():find("knife") then return end
    pcall(function()
        -- Da Hood style shoot args (best-effort)
        MainEvent:FireServer("ShootGun", tool, my.Position, head.Position, head, head.Position, head, 999)
    end)
    pcall(function()
        MainEvent:FireServer("Shoot", tool, my.Position, head.Position)
    end)
end

local function activateKnife()
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if tool and tool.Name:lower():find("knife") then
        pcall(function() tool:Activate() end)
    end
end

local function doStomp(target)
    refreshMainEvent()
    local tChar = getChar(target)
    if not tChar or not isKO(tChar) then return end
    local ut = tChar:FindFirstChild("UpperTorso") or getRoot(tChar)
    local my = getRoot(LocalPlayer.Character)
    if not ut or not my then return end
    my.CFrame = CFrame.new(ut.Position + Vector3.new(0, 3.2, 0))
    my.AssemblyLinearVelocity = Vector3.zero
    for _ = 1, 5 do
        pcall(function() MainEvent:FireServer("Stomp") end)
        task.wait(0.03)
    end
end

local function summonCF()
    local ctrl = getController()
    if not ctrl then return nil end
    local oRoot = getRoot(getChar(ctrl))
    if not oRoot then return nil end
    local slot = MySlot
    local pairIndex = math.ceil(slot / 2)
    local side = (slot % 2 == 1) and -1 or 1
    local x = side * pairIndex * FollowSpacing
    local row = math.floor((slot - 1) / 6)
    local cf = oRoot.CFrame
    local pos = oRoot.Position
        - cf.LookVector * (FollowBack + row * FollowBack)
        + cf.RightVector * x
        + Vector3.new(0, 2 + row * HeightPerRow, 0)
    return CFrame.new(pos, pos + cf.LookVector)
end

local function stopAll()
    CurrentAction = "idle"
    TargetPlayer = nil
    TargetList = {}
    FormationType = nil
    if KillConn then pcall(function() KillConn:Disconnect() end) KillConn = nil end
    if FollowConn then pcall(function() FollowConn:Disconnect() end) FollowConn = nil end
end

local function startFollow()
    local ctrl = getController()
    if not ctrl or ctrl == LocalPlayer then return end
    stopAll()
    CurrentAction = "follow"
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "follow" then return end
        local dest = summonCF()
        local my = getRoot(LocalPlayer.Character)
        if dest and my then
            my.Anchored = false
            my.CanCollide = false
            my.CFrame = dest
            my.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

local function killOffset(tRoot)
    local slot = MySlot
    if KillMethod == "sky" or KillMethod == "skykill" then
        local ang = ((slot - 1) / math.max(1, MaxBots)) * math.pi * 2
        return Vector3.new(math.cos(ang) * 10, 175, math.sin(ang) * 10)
    end
    if KillMethod == "stand" or KillMethod == "standkill" then
        local ang = ((slot - 1) / math.max(1, MaxBots)) * math.pi * 2
        return Vector3.new(math.cos(ang) * 4, 4, math.sin(ang) * 4)
    end
    if KillMethod == "stkill" then
        return Vector3.new(0, 8, 0)
    end
    if KillMethod == "tkill" then
        return Vector3.new(0, 200, 0)
    end
    -- orbit / default
    local ang = ((slot - 1) / math.max(1, MaxBots)) * math.pi * 2
    local dist = UseGun and 10 or 3
    return Vector3.new(math.cos(ang) * dist, 2, math.sin(ang) * dist)
end

local function startKill(targets, isAuto)
    if type(targets) ~= "table" then targets = { targets } end
    local filtered = {}
    for _, t in ipairs(targets) do
        if t and not isWhitelisted(t) then filtered[#filtered + 1] = t end
    end
    if #filtered == 0 then return end
    stopAll()
    TargetList = filtered
    TargetPlayer = filtered[1]
    CurrentAction = isAuto and "autokill" or "kill"
    local phase = "attack"
    local tkillDir = -1
    KillConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "kill" and CurrentAction ~= "autokill" then return end
        local t = TargetPlayer
        if not t or not t.Parent then
            if isAuto then
                -- wait for rejoin / stay idle
                return
            end
            stopAll()
            startFollow()
            return
        end
        local tChar = getChar(t)
        if not tChar then return end
        local my = getRoot(LocalPlayer.Character)
        local tr = getRoot(tChar)
        if not my or not tr then return end

        if isKO(tChar) then
            if StompOnKill or AutoStompEnabled then
                if (tonumber(MySlot) or 1) == 1 then
                    doStomp(t)
                end
            end
            if not isAuto then
                stopAll()
                startFollow()
            else
                -- wait FF gone after respawn
                phase = "waitff"
            end
            return
        end

        if phase == "waitff" then
            if hasForceField(tChar) then
                equipSelected()
                return
            end
            phase = "attack"
        end

        if hasForceField(tChar) then
            equipSelected()
            return
        end

        equipSelected()
        my.CanCollide = false
        my.Anchored = false

        if KillMethod == "tkill" then
            local top = tr.Position + Vector3.new(0, 200, 0)
            local bot = tr.Position + Vector3.new(0, -8, 0)
            if tkillDir < 0 then
                my.CFrame = CFrame.new(top, tr.Position)
                tkillDir = 1
            end
            local goal = tkillDir > 0 and bot or top
            local dir = goal - my.Position
            local step = math.min(1200 * 0.016, dir.Magnitude)
            if dir.Magnitude > 1 then
                my.CFrame = CFrame.new(my.Position + dir.Unit * step, tr.Position)
            else
                tkillDir = -tkillDir
            end
            my.AssemblyLinearVelocity = Vector3.zero
            if UseGun then shootTarget(t) else activateKnife() end
            return
        end

        if KillMethod == "stkill" then
            my.CFrame = CFrame.new(tr.Position + Vector3.new(0, 8, 0), tr.Position)
            my.AssemblyLinearVelocity = Vector3.zero
            if UseGun then shootTarget(t) else activateKnife() end
            return
        end

        local off = killOffset(tr)
        local dest = CFrame.lookAt(tr.Position + off, tr.Position)
        my.CFrame = dest
        my.AssemblyLinearVelocity = Vector3.zero
        if UseGun then shootTarget(t) else activateKnife() end
    end)
end

local function startBring(target)
    if not target then return end
    if (tonumber(MySlot) or 1) > 1 then
        startKill({ target }, false)
        return
    end
    stopAll()
    CurrentAction = "bring"
    TargetPlayer = target
    local saved = nil
    pcall(function()
        local r = getRoot(LocalPlayer.Character)
        if r then saved = r.CFrame end
    end)
    task.spawn(function()
        local deadline = tick() + 20
        while CurrentAction == "bring" and tick() < deadline do
            if isKO(getChar(target)) then break end
            if not hasForceField(getChar(target)) then
                equipSelected()
                local my = getRoot(LocalPlayer.Character)
                local tr = getRoot(getChar(target))
                if my and tr then
                    my.CFrame = CFrame.new(tr.Position + Vector3.new(0, 3, 3), tr.Position)
                    if UseGun then shootTarget(target) else activateKnife() end
                end
            end
            task.wait(0.05)
        end
        if CurrentAction ~= "bring" then return end
        -- grab
        local my = getRoot(LocalPlayer.Character)
        local tr = getRoot(getChar(target))
        if my and tr then
            my.CFrame = CFrame.new(tr.Position + Vector3.new(0, 2.5, 0))
            task.wait(0.25)
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
            end)
            task.wait(0.5)
        end
        local ctrl = getController()
        local cr = getRoot(getChar(ctrl))
        my = getRoot(LocalPlayer.Character)
        if my and cr then
            my.CFrame = cr.CFrame * CFrame.new(0, 0, 3)
        elseif my and saved then
            my.CFrame = saved
        end
        task.wait(0.2)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
        end)
        stopAll()
        startFollow()
    end)
end

local function parsePrefix(msg)
    local lower = (msg or ""):lower():gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    if lower:sub(1, 1) == "!" or lower:sub(1, 1) == "." then
        return lower:sub(2):match("^%s*(.-)%s*$")
    end
    local bare = {
        summon = true, follow = true, come = true, stop = true, idle = true,
        kill = true, k = true, autokill = true, ak = true, bring = true, b = true,
        gun = true, knife = true, reset = true, r = true,
        ["return"] = true,
        skykill = true, standkill = true, orbitkill = true, stkill = true, tkill = true,
    }
    local first = lower:match("^(%S+)")
    if first and bare[first] then return lower end
    return nil
end

