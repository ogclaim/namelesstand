local function getChar(plr)
    return plr and plr.Character
end

local function getHum(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
end

local function refreshChar()
    Character = LocalPlayer.Character
    if Character then
        Humanoid = Character:FindFirstChildOfClass("Humanoid")
        Root = getRoot(Character)
    end
end

local function isOwner(plr)
    if not plr then return false end
    local n = plr.Name:lower()
    if n == ControllerName:lower() then return true end
    if n == OriginalControllerName:lower() then return true end
    for _, e in ipairs(ExtraOwners) do
        if n == tostring(e):lower() then return true end
    end
    return false
end

local function isWhitelisted(plr)
    if not plr then return false end
    if isOwner(plr) then return true end
    if BotList[plr.Name:lower()] then return true end
    if Whitelist[plr.Name:lower()] then return true end
    return false
end

local function findPlayer(name)
    if not name or name == "" then return nil end
    name = tostring(name):lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or (p.DisplayName and p.DisplayName:lower() == name) then
            return p
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(name, 1, true) or (p.DisplayName and p.DisplayName:lower():find(name, 1, true)) then
            return p
        end
    end
    return nil
end

local function isKO(char)
    if not char then return true end
    local be = char:FindFirstChild("BodyEffects")
    if be then
        local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
        if ko and ko.Value then return true end
        local dead = be:FindFirstChild("Dead")
        if dead and dead.Value then return true end
    end
    local h = getHum(char)
    if h and h.Health <= 0 then return true end
    return false
end

local function hasForceField(char)
    if not char then return true end
    if char:FindFirstChildOfClass("ForceField") then return true end
    if char:FindFirstChild("ForceField") then return true end
    local be = char:FindFirstChild("BodyEffects")
    if be then
        local ff = be:FindFirstChild("ForceField") or be:FindFirstChild("FF")
        if ff and ff:IsA("BoolValue") and ff.Value then return true end
    end
    return false
end

local function shouldSkipTarget(plr)
    if not plr then return true end
    if isWhitelisted(plr) then return true end
    local c = getChar(plr)
    if not c then return true end
    if isKO(c) then return true end
    if hasForceField(c) then return true end
    return false
end

local function isGrabbed(plr)
    local c = getChar(plr)
    if not c then return false end
    return c:FindFirstChild("GRABBING_CONSTRAINT") ~= nil
end

local function getController()
    return Players:FindFirstChild(ControllerName) or findPlayer(ControllerName)
end

