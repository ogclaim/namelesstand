local function doStomp(target)
    if MySlot ~= StompBotSlot and MySlot ~= 1 then return end
    if not StompOnKill and not AutoStompEnabled then return end
    local me = refreshMainEvent()
    local tChar = getChar(target)
    if not tChar then return end
    local be = tChar:FindFirstChild("BodyEffects")
    local ko = be and (be:FindFirstChild("K.O") or be:FindFirstChild("KO"))
    if ko and not ko.Value then return end
    if isGrabbed(target) then return end
    local my = getRoot(LocalPlayer.Character)
    local ut = tChar:FindFirstChild("UpperTorso") or getRoot(tChar)
    if not my or not ut then return end
    local last = my.CFrame
    my.CFrame = CFrame.new(ut.Position + Vector3.new(0, 2.5, 0))
    for _ = 1, 8 do
        if me then pcall(function() me:FireServer("Stomp") end) end
        RunService.Heartbeat:Wait()
        if ut.Parent then my.CFrame = CFrame.new(ut.Position + Vector3.new(0, 2.5, 0)) end
    end
    task.wait(0.1)
    if my.Parent then my.CFrame = last end
end

