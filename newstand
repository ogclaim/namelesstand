        -- this script can issue orders: every alt's poller sees them and acts.
        -- Each alt's own poller still skips lines it authored itself, and the
        -- 30s echo guard in writeOrder keeps fleet copies out of the file.
        -- Only recognized OWNER accounts may issue orders (also via chat echo).
        if parseCommand(msg) and isOwnerUid(plr.UserId) then
