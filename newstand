local DZ_GM_ANIM_ID = "70883871260184"
local dzGmOn = false
local dzGmTrack = nil
local dzGmStepped = nil

local function dzGodAnim()
    local char = localPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. DZ_GM_ANIM_ID
    dzGmTrack = animator:LoadAnimation(a)
    dzGmTrack.Priority = Enum.AnimationPriority.Core
    dzGmTrack:Play(0, 1, 0)
    a:Destroy()
    task.delay(0, function()
        if dzGmTrack then
            dzGmTrack.TimePosition = 0.7
            task.delay(0.3, function()
                if dzGmTrack then dzGmTrack:AdjustSpeed(0) end
            end)
        end
    end)
    if dzGmStepped then dzGmStepped:Disconnect() end
    dzGmStepped = RunService.Stepped:Connect(function()
        if not dzGmOn or not localPlayer.Character then
            if dzGmStepped then dzGmStepped:Disconnect(); dzGmStepped = nil end
            return
        end
        for _, desc in ipairs(localPlayer.Character:GetDescendants()) do
            if desc:IsA("Motor6D") then
                desc.Transform = CFrame.new()
            end
        end
    end)
    return true
end

dzGodStart = function()
    if dzGmOn then return end
    dzGmOn = true
    if not dzGodAnim() then dzGmOn = false return end
    library:Notification({text = "Godmode enabled", time = 2})
end

dzGodStop = function()
    if not dzGmOn then return end
    dzGmOn = false
    if dzGmTrack then pcall(function() dzGmTrack:Stop() end); dzGmTrack = nil end
    if dzGmStepped then dzGmStepped:Disconnect(); dzGmStepped = nil end
    library:Notification({text = "Godmode disabled", time = 2})
end

