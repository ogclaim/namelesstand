                        local authorUid = tonumber(a)
                        local proceed = true
                        if authorUid == localPlayer.UserId then
                            print("[STAND-ALT] own order skipped (I am the author)")
                            proceed = false
                        elseif not isOwnerUid(authorUid) then
                            print("[STAND-ALT] order from non-owner", authorUid, "- rejected")
                            proceed = false
                        end
                        if proceed then
                            local author = Players:GetPlayerByUserId(authorUid)
                            if not author then
                                if cmd == "stop" then
                                    print("[STAND-ALT] order author", authorUid, "not in server - executing stop anyway")
