local function shootTarget(target)
    local me = refreshMainEvent()
    if not me or not target then return false end
    local tChar = getChar(target)
    if not tChar or isKO(tChar) or hasForceField(tChar) then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or not tool:FindFirstChild("Handle") or tool.Name:lower():find("knife") then
        tool = equipSelectedGuns()
    end
    if not tool or not tool:FindFirstChild("Handle") then return false end
    local handle = tool.Handle
    local head = tChar:FindFirstChild("Head") or getRoot(tChar)
    if not head then return false end
    for _ = 1, 3 do
        pcall(function()
            me:FireServer("ShootGun", handle, handle.Position, head.Position + Vector3.new(0, 1, 0), head, Vector3.new())
        end)
        pcall(function() tool:Activate() end)
    end
    tryReload()
    return true
end

local function knifeHit(target)
    local tChar = getChar(target)
    if not tChar or isKO(tChar) then return false end
    local tool = equipKnife()
    local my = getRoot(LocalPlayer.Character)
    local tr = getRoot(tChar)
    if not my or not tr then return false end
    my.CFrame = tr.CFrame * CFrame.new(0, 0, 2)
    if tool then pcall(function() tool:Activate() end) end
