function F.GetSummonCF()
    local c = F.GetController()
    local cr = c and c.Character and c.Character:FindFirstChild("HumanoidRootPart")
    if not cr then return nil end
    local slot = MySlot or 1
    local i = slot - 1
    local b = cr.CFrame
    local look, right = b.LookVector, b.RightVector
    local col = i % 3
    local row = math.floor(i / 3)
    local fm = FLY_MODE_OFFSET[FlyMode or "Hover"] or { y = 2.5, back = 0 }
    local pos = cr.Position - look * (FollowBack + row * FollowBack + (fm.back or 0)) + right * ((col - 1) * FollowSpacing) + Vector3.new(0, FollowHeight + row * 1.5 + (fm.y or 0), 0)
    return CFrame.new(pos, pos + look)
end

function F.GetAroundCF()
    local c = F.GetController()
    local cr = c and c.Character and c.Character:FindFirstChild("HumanoidRootPart")
    if not cr then return nil end
    local slot = MySlot or 1
    local look, right = cr.CFrame.LookVector, cr.CFrame.RightVector
    local dirs = { -look, look, -right, right }
    local pillar = ((slot - 1) % 4) + 1
    local stack = math.floor((slot - 1) / 4)
    local d = dirs[pillar]
    local pos = cr.Position + d * 5 + Vector3.new(0, 5 + stack * StackHeight, 0)
    return CFrame.new(pos, pos + look)
end

-- Controller orbit formations (all bots different phase)
function F.GetControllerOrbitCF()
    local c = F.GetController()
    local cr = c and c.Character and c.Character:FindFirstChild("HumanoidRootPart")
    if not cr then return nil end
    local slot = MySlot or 1
    local n = math.max(10, #BotOrder > 0 and #BotOrder or 10)
    local phase = ((slot - 1) / n) * math.pi * 2
    local t = tick() * (CtrlOrbitSpeed or 10)
    local mode = CtrlOrbitMode or 1
    local origin = cr.Position
    local pos
    if mode == 2 then
        -- vertical circle (YZ plane relative to controller facing)
        local look = cr.CFrame.LookVector
        local right = cr.CFrame.RightVector
        local up = Vector3.new(0, 1, 0)
        local ang = t + phase
        local d = CtrlOrbitDist or 10
        pos = origin + right * (math.cos(ang) * d) + up * (math.sin(ang) * d)
    elseif mode == 3 then
        -- pulse radius between in and out
        local ang = t + phase
        local pulse = (math.sin(t * 1.5) + 1) * 0.5 -- 0..1
        local d = (CtrlOrbitInDist or 5) + pulse * ((CtrlOrbitOutDist or 10) - (CtrlOrbitInDist or 5))
        pos = origin + Vector3.new(math.cos(ang) * d, 2, math.sin(ang) * d)
    else
        -- mode 1: horizontal circle
        local ang = t + phase
        local d = CtrlOrbitDist or 10
        pos = origin + Vector3.new(math.cos(ang) * d, 3, math.sin(ang) * d)
    end
    return CFrame.new(pos, origin)
end

function F.StartControllerOrbit(mode)
    if F.IsControllerClient() then return end
    F.StopAll()
    CtrlOrbitMode = tonumber(mode) or 1
    CurrentAction = "formation"
    FormationType = "corbit"
    FormationTarget = F.GetController()
    ProtectOwnerEnabled = false
    F.StartGlue("formation", F.GetController())
end

function F.StopAll()
    CurrentAction = "idle"
    TargetPlayer = nil
    TargetList = {}
    F.StopGlue()
    if FollowConnection then FollowConnection:Disconnect() FollowConnection = nil end
    if KillAttackConn then KillAttackConn:Disconnect() KillAttackConn = nil end
    ProtectOwnerEnabled = false
    if ProtectOwnerConn then ProtectOwnerConn:Disconnect() ProtectOwnerConn = nil end
end

