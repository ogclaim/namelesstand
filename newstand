            if phase == "dive" then
                wantedY = fireAlt
                if math.abs(cy - fireAlt) <= 6 then
                    arriveBeats = arriveBeats + 1
                    settledFrames = settledFrames + 1
                    -- Settle gate: require 3 consecutive frames at fireAlt before
                    -- firing. The CFrame snap is client-only; the server needs
                    -- time to accept the position. Firing before settlement
                    -- causes origin-mismatch kicks (server sees alt at -600).
                    if fireStart == 0 and settledFrames >= 3 then
                        fireStart = T
                        if not diveReported then
                            diveReported = true
                            print("[STAND-FORCEHIT] settled at", math.floor(fireAlt), "- firing there")
                        end
                    end
                else
                    arriveBeats = 0
                    settledFrames = 0
                end
                if fireStart ~= 0 and T - fireStart >= FIRE_WINDOW then
                    phase = "climb"
                    phaseStart = T
                    print("[STAND-FORCEHIT] window done - retreating to", RETREAT_ALT)
                elseif fireStart == 0 and T - phaseStart > 1.5 then
                    -- descent not sticking (server reverts the snap): re-arm the
                    -- dive instead of hovering at altitude forever in silence
                    phaseStart = T
                    pcall(function() root:SetNetworkOwner(localPlayer) end)
                    rejectReported = false
                    print("[STAND-FORCEHIT] dive stuck - re-arming dive")
                end
            elseif phase == "climb" then
                wantedY = RETREAT_ALT
                if math.abs(cy - RETREAT_ALT) <= 8 then
                    phase = "wait"
                    phaseStart = T
                elseif T - phaseStart > 2.0 then
                    -- climb stuck (server reverted retreat snap): skip to wait
                    -- so the dive cycle can restart instead of looping forever
                    phase = "wait"
                    phaseStart = T
                    print("[STAND-FORCEHIT] climb stuck - skipping to wait")
                end
            else -- wait
                wantedY = RETREAT_ALT
                if T - phaseStart >= CYCLE_WAIT then
                    phase = "dive"
                    fireStart = 0
                    settledFrames = 0
                end
            end
            local ac = anticheatFlag()
            local unscriptedYank = (phase == "wait") and (math.abs(lastY - cy) > 400)
            -- After respawn, forcefield is spawn protection not anticheat - skip the hold
            if ac == "forcefield" and T < respawnGraceUntil then ac = nil end
            if ac or unscriptedYank then
                if not holdActive then
                    holdActive = true
                    holdStarted = T
                end
                -- Short hold for physical flags (forcefield / yank), longer for
                -- value flags (real punishment - stay safe). Hard ceiling: a flag
                -- that never clears must not leave the alt inert forever (that is
                -- the ,fr-needing dead state): after 20s of forcefield, fire anyway.
                local shortHold = (ac == "forcefield" or unscriptedYank) and 8 or 20
                if ac == "forcefield" and T - holdStarted > 20 then
                    acHoldUntil = T
                    if not ffStuckReported then
                        ffStuckReported = true
                        print("[STAND-FORCEHIT] forcefield stuck >20s - firing anyway")
                    end
                else
                    acHoldUntil = T + shortHold
                end
                if not acReported then
                    acReported = true
                    print("[STAND-FORCEHIT] anticheat:", ac or "yank", "- holding fire", shortHold, "s")
                end
            else
                holdActive = false
                acReported = false
            end
            lastY = cy
            if T < acHoldUntil then wantedY = RETREAT_ALT end
            local dt = T - lastBeat
            lastBeat = T
            -- Snap ABOVE THE TARGET (its X/Z), not our own: at 5k the alt's own
            -- X/Z can be hundreds of studs off, making every real ray way out
            -- of shotgun range even at DB_FIRE_ALT.
            local tRoot = altTarget.Character and altTarget.Character:FindFirstChild("HumanoidRootPart")
            local tx = tRoot and tRoot.Position.X or root.Position.X
            local tz = tRoot and tRoot.Position.Z or root.Position.Z
            pcall(function() root:SetNetworkOwner(localPlayer) end)
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                -- Insta-snap to the target altitude (same as the old hover, which
                -- provably worked): gradual movement loses to physics sync.
                root.CFrame = CFrame.new(tx, wantedY, tz)
            end)
            if sethiddenproperty then
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
            end
            -- Re-read Y after snap so fire gates use actual position
            cy = root.Position.Y
            -- (instant-fire removed: settledFrames gate above prevents void-origin shots)
            -- Diagnostics: window open but still high up = the server is
            -- reverting our descent snap. Also a 2.5s status line.
            if phase == "dive" and cy > fireAlt + 200 and not rejectReported then
                rejectReported = true
                print("[STAND-FORCEHIT] WARNING: descent not sticking, still at cy=", math.floor(cy))
            end
            if T - statusLast > 2.5 then
                statusLast = T
                print(string.format("[STAND-FORCEHIT] status phase=%s cy=%.0f holdIn=%s ac=%s",
                    phase, cy, tostring(T < acHoldUntil), ac or "none"))
            end
            -- Hold (any anticheat signal): stay high, no firing
            if T < acHoldUntil then return end
            -- Only fire in the fire phase, once actually at fire range
            if phase ~= "dive" then return end
            if math.abs(cy - fireAlt) > 6 then return end
            if fireStart == 0 or T - fireStart >= FIRE_WINDOW then return end
        else
            -- Ground mode: anticheat hold pauses everything
            local ac = anticheatFlag()
            if ac or (lastY - cy > 400) then
                acHoldUntil = T + 10
                if not acReported then
                    acReported = true
                    print("[STAND-FORCEHIT] anticheat:", ac or "yank", "- holding fire 10s")
                end
            else
                acReported = false
            end
            lastY = cy
            if T < acHoldUntil then
                clearGlue()
                return
            end
        end
        -- Respawn gap (character gone): wait for the victim to come back at
        -- altitude (never sit on the body), then the dive-cycle re-arms.
        if not altTarget.Character then
            if not waitReported then
                waitReported = true
                print("[STAND-FORCEHIT] target respawning - waiting at altitude")
            end
            killDone = false
            clearGlue()
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = CFrame.new(root.Position.X, RETREAT_ALT, root.Position.Z)
            end)
            if sethiddenproperty then
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
            end
            return
        end
        -- Perm death (SDeath) -> hover at 5k until the target respawns, then
        -- the normal dive-cycle re-arms and we re-attack automatically
        if isTargetSDead() then
            if not killDone then
                killDone = true
                print("[STAND-FORCEHIT] target perm-dead - hovering, re-attack on respawn")
            end
            local tRoot2 = altTarget.Character and altTarget.Character:FindFirstChild("HumanoidRootPart")
            local hx = tRoot2 and tRoot2.Position.X or root.Position.X
            local hz = tRoot2 and tRoot2.Position.Z or root.Position.Z
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = CFrame.new(hx, RETREAT_ALT, hz)
            end)
            if sethiddenproperty then
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
            end
            return
        end
        killDone = false
        -- Spawn protection: hold fire until the forcefield runs out.
        -- Reset fireStart so the settle gate re-arms fresh when forcefield clears.
        if targetHasForceField() then
            fireStart = 0
            settledFrames = 0
            if not ffReported then
                ffReported = true
                print("[STAND-FORCEHIT] target in spawn protection - holding fire")
            end
            clearGlue()
            return
        end
        local targetPart = getForceHitPart()
        if not targetPart then return end
        -- Always equip the DB (so the server accepts the shots)
        local db = equipDB()
        if not db and not dbReported then
            dbReported = true
            print("[STAND-FORCEHIT] DB not found in char or backpack!")
        end
        -- Airborne: keep the dive-cycle altitude (cy), just face the target.
        -- NOTE: do NOT re-snap to the retreat altitude here - that old hover line reset
        -- the altitude right before each shot and fired from 5k (no damage).
        pcall(function() root:SetNetworkOwner(localPlayer) end)
        -- Bullet TP mode: stay at 100 studs above target (sniper DB), fire downwards
        local BULLET_TP_ALT = 100
        local tRoot0 = altTarget.Character and altTarget.Character:FindFirstChild("HumanoidRootPart")
        local tx = tRoot0 and tRoot0.Position.X or root.Position.X
        local tz = tRoot0 and tRoot0.Position.Z or root.Position.Z
        
        -- Teleport to 100 studs above target if not there
        if math.abs(root.Position.Y - BULLET_TP_ALT) > 10 or (root.Position - Vector3.new(tx, BULLET_TP_ALT, tz)).Magnitude > 10 then
            pcall(function()
                root:SetNetworkOwner(localPlayer)
                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = CFrame.new(tx, BULLET_TP_ALT, tz)
            end)
            if sethiddenproperty then
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
            end
            return
        end
        
        -- Check for roof/obstruction above target - raycast down from 150
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { localPlayer.Character, altTarget.Character }
        local downHit = workspace:Raycast(Vector3.new(tx, BULLET_TP_ALT, tz), Vector3.new(0, -BULLET_TP_ALT + 5, 0), rp)
        local fireY = BULLET_TP_ALT
        if downHit then
            -- Obstruction found (roof/tree), fire from just above it
            fireY = downHit.Position.Y + 5
            print("[STAND-FORCEHIT] obstruction at", downHit.Position.Y, "- firing from", fireY)
        end
        
        -- Position at fire altitude above target
        pcall(function()
            root:SetNetworkOwner(localPlayer)
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(tx, fireY, tz)
        end)
        if sethiddenproperty then
            pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
        end
        
        -- Face target and aim down
        pcall(function()
            root.CFrame = CFrame.lookAt(Vector3.new(tx, fireY, tz), targetPart.Position)
        end)
        
        -- Disable collision on body parts only (exclude Head, Face, Hair, Accessories)
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    local name = part.Name:lower()
                    if not (name == "head" or name:find("face") or name:find("hair") or part:IsA("Accessory") or part:FindFirstAncestorWhichIsA("Accessory")) then
                        part.CanCollide = false
                    end
                end
            end
        end
        
        -- Aim the head/neck pitch at the target
        local head = char:FindFirstChild("Head")
        local neck = (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck"))
            or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck"))
        if head and neck then
            local dir = (targetPart.Position - head.Position).Unit
            pcall(function()
                neck.C0 = CFrame.new(neck.C0.Position)
                    * CFrame.Angles(math.asin(math.clamp(dir.Y, -1, 1)) * -1, math.atan2(-dir.X, -dir.Z), 0)
            end)
        end
        
        -- Keep the DB loaded
        if dbAmmoEmpty(db) == true or tick() - lastReloadTime >= 0.6 then
            tryReload(db)
        end
        
        -- Fire the simulated DB pellets (larptic Shoot)
        if tick() - lastShootTime >= FORCEHIT_SHOOT_INTERVAL and T >= ratePauseUntil then
            -- Forcefield guard: don't shoot a target that just respawned/is in FF
            if altTarget.Character and altTarget.Character:FindFirstChildOfClass("ForceField") then
                if not ffStuckReported then
                    ffStuckReported = true
                    print("[STAND-FORCEHIT] target in forcefield - waiting")
                end
                return
            else
                ffStuckReported = false
            end
            
            -- Wallbang guard: raycast from fire position to target
            -- Ignore the roof we already detected (downHit) - only block on walls BETWEEN fire pos and target
            local rp2 = RaycastParams.new()
            rp2.FilterType = Enum.RaycastFilterType.Exclude
            rp2.FilterDescendantsInstances = { localPlayer.Character, altTarget.Character }
            local blockHit = workspace:Raycast(Vector3.new(tx, fireY, tz), targetPart.Position - Vector3.new(tx, fireY, tz), rp2)
            if blockHit then
                -- Ignore the roof we already detected - only block on actual walls
                if downHit and blockHit.Instance == downHit.Instance then
                    blockReported = false
                else
                    if not blockReported then
                        blockReported = true
                        print("[STAND-FORCEHIT] wallbang blocked - holding fire (", math.floor(blockHit.Distance), "studs to obstacle)")
                    end
                    return
                end
            else
                blockReported = false
            end
            if tick() - volleyWinStart > 30 then
                volleyWinStart = tick()
                volleyCount = 0
            end
            if volleyCount >= 50 then
                -- rate cap: too many volleys in 30s -> cooldown at altitude,
                -- then resume. Prevents "too many origin mismatches" kicks.
                ratePauseUntil = T + 8
                volleyCount = 0
                if not rateReported then
                    rateReported = true
                    print("[STAND-FORCEHIT] volley cap hit - cooling 8s at altitude")
                end
            elseif volleyCount > 0 then
                rateReported = false
            end
            if T < ratePauseUntil then
                -- stay at altitude during the cooldown
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
root.CFrame = CFrame.new(root.Position.X, RETREAT_ALT, root.Position.Z)
                end)
            else
                volleyCount = volleyCount + 1
            local hits = {}
            local tparts = {}
            for i = 1, 5 do
                hits[i] = { Normal = targetPart.Position, Instance = targetPart, Position = targetPart.Position }
                tparts[i] = { thePart = targetPart, theOffset = Vector3.zero }
            end
            -- Airborne: fire at close range with a real, lightly-jittered origin
            -- so the server sees shooter-consistent origins (no mismatch kicks)
            -- and the ray is short enough for shotgun damage. Ground: plain.
            local origin = AIRBORNE and jitterOrigin(root) or root.Position
            local args = {
                hits,
                tparts,
                origin,
                origin,
                workspace:GetServerTimeNow(),
            }
            pcall(function() MainEvent:FireServer("Shoot", args) end)
            lastShootTime = tick()
            if not shootReported then
                shootReported = true
                print("[STAND-FORCEHIT] firing DB at", targetPart.Name)
            end
            end
        end
    end, function(err)
        if not errReported then
            errReported = true
            print("[STAND-FORCEHIT] ERROR:", tostring(err))
        end
    end)
end)
end
