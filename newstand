local FollowSpacing = 3

getgenv().get_root_part = function()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    return hum.RootPart or char:FindFirstChild("HumanoidRootPart")
end

getgenv().reset_velocity = function()
    local r = getgenv().get_root_part()
    if r then
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end

getgenv().get_position_offset = function()
    local d = getgenv().glue_offset_z or 3
    local p = getgenv().glue_position or "Back"
    if p == "Front" then return CFrame.new(0, 0, -d) end
    if p == "Left Side" then return CFrame.new(-d, 0, 0) end
    if p == "Right Side" then return CFrame.new(d, 0, 0) end
    if p == "Top" then return CFrame.new(0, d, 0) end
    if p == "Bottom" then return CFrame.new(0, -d, 0) end
    return CFrame.new(0, 0, d) -- Back
end

local function SetPhysicsRepRootPart(selfRoot, targetPart)
    if not selfRoot or not targetPart then return end
    if sethiddenproperty then
        pcall(function()
            sethiddenproperty(selfRoot, "PhysicsRepRootPart", targetPart)
        end)
        pcall(function()
            if InstanceHandle then
                sethiddenproperty(selfRoot, "PhysicsRepRootRef", InstanceHandle.new(targetPart))
            end
        end)
    end
    pcall(function()
        if setsimulationradius then setsimulationradius(math.huge, math.huge) end
    end)
    pcall(function()
        selfRoot:SetNetworkOwner(LocalPlayer)
    end)
end

local function GetSummonWorldCF()
    local owner = getController()
    if not owner or not owner.Character then return nil end
    local oRoot = owner.Character:FindFirstChild("HumanoidRootPart")
    if not oRoot then return nil end
    local slot = math.max(1, math.floor(MySlot or 1))
    local perRow = math.max(1, math.floor(FormationPerRow or 3))
    local col = (slot - 1) % perRow
    local row = math.floor((slot - 1) / perRow)
    local x = (col - (perRow - 1) * 0.5) * (FollowSpacing or FollowSide or 3)
    local z = (FollowBack or 4) + row * (FollowBack or 4)
    local y = (FollowHeight or 2) * row
    return oRoot.CFrame * CFrame.new(x, y, z)
end

local function GetFormationCF()
    local t = FormationTarget or getController()
    local tr = getRoot(getChar(t))
    if not tr then return nil end
    local slot = MySlot or 1
    local kind = FormationType or "bline"
    if kind == "bline" then
        return tr.CFrame * CFrame.new(0, 0, 3 + slot * 2.5)
    elseif kind == "back" then
        local col = (slot - 1) % 4
        local row = math.floor((slot - 1) / 4)
        return tr.CFrame * CFrame.new((col - 1.5) * 3, row * 2, 5 + row)
    elseif kind == "line" then
        local side = (slot % 2 == 0) and 1 or -1
        local idx = math.ceil(slot / 2)
        return tr.CFrame * CFrame.new(side * (3 + idx * 2.5), 0, 0)
    elseif kind == "around" then
        local a = ((slot - 1) / math.max(MaxBots, 1)) * math.pi * 2
        return CFrame.new(tr.Position + Vector3.new(math.cos(a) * 5, 5, math.sin(a) * 5), tr.Position)
    elseif kind == "orbit" then
        OrbitAngle = OrbitAngle + 0.08
        local a = OrbitAngle + ((slot - 1) / math.max(MaxBots, 1)) * math.pi * 2
        return CFrame.new(tr.Position + Vector3.new(math.cos(a) * 10, 3, math.sin(a) * 10), tr.Position)
    end
    return tr.CFrame * CFrame.new(0, 2, 4)
end

local function resolveTargetRoot()
    if GlueMode == "follow" then
        local c = getController()
        return c and c.Character and c.Character:FindFirstChild("HumanoidRootPart")
    elseif GlueMode == "formation" then
        local t = FormationTarget
        return t and t.Character and t.Character:FindFirstChild("HumanoidRootPart")
    else
        local t = GlueTargetPlayer or TargetPlayer
        return t and t.Character and t.Character:FindFirstChild("HumanoidRootPart")
    end
end

-- Pure CFrame only (no PhysicsRep / glue - blocked by anticheat)
getgenv().unc_connection = function()
    if getgenv().connection_loop then
        getgenv().connection_loop:Disconnect()
        getgenv().connection_loop = nil
    end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CanCollide = false end
    getgenv().connection_loop = RunService.Heartbeat:Connect(function()
        if not getgenv().glue_active then
            if getgenv().connection_loop then
                getgenv().connection_loop:Disconnect()
                getgenv().connection_loop = nil
            end
            getgenv().reset_velocity()
            return
        end
        local selfRoot = getgenv().get_root_part()
        if not selfRoot then return end
        selfRoot.CanCollide = false

        -- Kill: killStep sets CFrame; do nothing else here
        if CurrentAction == "kill" or CurrentAction == "autokill" or CurrentAction == "bring" then
            return
        end

        local dest
        if GlueMode == "follow" or CurrentAction == "follow" then
            dest = GetSummonWorldCF()
        elseif GlueMode == "formation" or CurrentAction == "formation" then
            dest = GetFormationCF()
        else
            local targetRoot = resolveTargetRoot()
            if targetRoot then
                dest = targetRoot.CFrame * getgenv().get_position_offset()
            end
        end
        if dest then
            selfRoot.AssemblyLinearVelocity = Vector3.zero
            selfRoot.AssemblyAngularVelocity = Vector3.zero
            selfRoot.CFrame = dest
        end
    end)
end

local function stopGlue()
    getgenv().glue_active = false
    if getgenv().connection_loop then
        pcall(function() getgenv().connection_loop:Disconnect() end)
        getgenv().connection_loop = nil
    end
    getgenv().reset_velocity()
    GlueTargetPlayer = nil
end

local function startGlue(mode, targetPlr)
    GlueMode = mode or "follow"
    GlueTargetPlayer = targetPlr
    getgenv().glue_active = true
    -- Instant CFrame only (no PhysicsRep)
    pcall(function()
        local selfRoot = getgenv().get_root_part()
        if not selfRoot then return end
        local dest
        if GlueMode == "follow" then
            dest = GetSummonWorldCF()
        elseif GlueMode == "formation" then
            dest = GetFormationCF()
        else
            local tr = targetPlr and getRoot(getChar(targetPlr))
            if tr then dest = tr.CFrame * getgenv().get_position_offset() end
        end
        if dest then
            selfRoot.CFrame = dest
            selfRoot.AssemblyLinearVelocity = Vector3.zero
            selfRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    getgenv().unc_connection()
end

local function stopAll()
    CurrentAction = "idle"
    TargetPlayer = nil
    TargetList = {}
    FormationType = nil
    FormationTarget = nil
    if FollowConn then pcall(function() FollowConn:Disconnect() end) FollowConn = nil end
    if ActionConn then pcall(function() ActionConn:Disconnect() end) ActionConn = nil end
    stopGlue()
    pcall(function()
        local h = getHum(LocalPlayer.Character)
        if h then h:UnequipTools() end
    end)
end

