-- slot from BotList usernames (1 = first name, etc.); fallback hash if not listed
local function hashName(n)
    local h = 0
    for i = 1, #n do h = (h * 31 + string.byte(n, i)) % 997 end
    return h
end
local function resolveMySlot()
    local my = LocalPlayer.Name:lower()
    for i, name in ipairs(BotList) do
        if type(name) == "string" and name ~= "" and name:lower() == my then
            return i
        end
    end
    return (hashName(LocalPlayer.Name) % MaxBots) + 1
end
local MySlot = resolveMySlot()
local function isListedBot()
    local my = LocalPlayer.Name:lower()
    for _, name in ipairs(BotList) do
        if type(name) == "string" and name ~= "" and name:lower() == my then
            return true
        end
    end
    return false
end
-- if BotList has any real names, only listed bots run stand logic
local _anyListed = false
for _, name in ipairs(BotList) do
    if type(name) == "string" and name ~= "" and not name:lower():find("botname") then
        _anyListed = true
        break
    end
end

local function getRoot(plr)
    local c = plr and plr.Character
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso"))
end

local function getHum(plr)
    local c = plr and plr.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function resolvePlayer(name)
    if not name or name == "" then return Controller or Players:FindFirstChild(ControllerName) end
    name = tostring(name):lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or p.DisplayName:lower() == name then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true) then return p end
    end
    return nil
end

local function stopGlue()
    if GlueConn then GlueConn:Disconnect() GlueConn = nil end
    pcall(function()
        if Root and sethiddenproperty then
            sethiddenproperty(Root, "PhysicsRepRootPart", nil)
        end
    end)
end

local function startGlue(targetPart)
    stopGlue()
    if not targetPart or not sethiddenproperty then return end
    GlueConn = RunService.Heartbeat:Connect(function()
        if not Root or not Root.Parent then return end
        if not targetPart or not targetPart.Parent then stopGlue() return end
        pcall(function()
            Root:SetNetworkOwner(LocalPlayer)
        end)
        pcall(function()
            sethiddenproperty(Root, "PhysicsRepRootPart", targetPart)
        end)
        pcall(function()
            workspace.FallenPartsDestroyHeight = math.huge
        end)
    end)
end

local function stopAll()
    CurrentAction = "idle"
    TargetPlayer = nil
    FormationType = nil
    PoseActive = nil
    NPCMode = false
    MineMode = false
    if FollowConn then FollowConn:Disconnect() FollowConn = nil end
    if ActionConn then ActionConn:Disconnect() ActionConn = nil end
    stopGlue()
    pcall(function()
        if Humanoid then Humanoid:UnequipTools() end
    end)
end

local function playAnim(id)
    pcall(function()
        if not Humanoid then return end
        for _, t in ipairs(Humanoid:GetPlayingAnimationTracks()) do t:Stop() end
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. tostring(id)
        local tr = Humanoid:LoadAnimation(a)
        tr:Play()
    end)
end

local function say(msg)
    if MuteSound then return end
    pcall(function()
        local tcs = game:GetService("TextChatService")
        local ch = tcs and tcs.TextChannels and tcs.TextChannels:FindFirstChild("RBXGeneral")
        if ch then ch:SendAsync(tostring(msg)) return end
    end)
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if re and re:FindFirstChild("SayMessageRequest") then
            re.SayMessageRequest:FireServer(tostring(msg), "All")
        end
    end)
end

local function multiOffset(index, total)
    if not MultiStand then return Vector3.new(0, FollowHeight, FollowBack) end
    local cols = 3
    local i = (index - 1)
    local row = math.floor(i / cols)
    local col = i % cols
    local x = (col - 1) * FollowSide
    local z = FollowBack + row * FollowBack
    local y = FollowHeight + row * 1.5
    return Vector3.new(x, y, z)
end

local function cframeBehind(targetRoot, offset)
    local cf = targetRoot.CFrame
    return cf * CFrame.new(offset)
end

-- ========== FOLLOW ==========
local function startFollow(target)
    stopAll()
    target = target or resolvePlayer()
    if not target then return end
    CurrentAction = "follow"
    TargetPlayer = target
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "follow" then return end
        refreshChar()
        local tr = getRoot(TargetPlayer)
        if not tr or not Root then return end
        local off = multiOffset(MySlot, MaxBots)
        if WeldEnabled and sethiddenproperty then
            -- glue to offset part: approximate by CFrame then glue to HRP with offset via CFrame still if glue is root-only
            startGlue(tr)
            -- keep slight offset with CFrame when glue weak
            Root.CFrame = cframeBehind(tr, off)
        else
            stopGlue()
            Root.CFrame = cframeBehind(tr, off)
            Root.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

-- ========== POSES (toggle) ==========
local PoseOffsets = {
    dog = function(t) return t.CFrame * CFrame.new(0, -2.5, -1) * CFrame.Angles(math.rad(90), 0, 0) end,
    bodyguard = function(t) return t.CFrame * CFrame.new(2.5, 0, 0) end,
    dih = function(t) return t.CFrame * CFrame.new(0, -1, -2) * CFrame.Angles(math.rad(-15), 0, 0) end,
    benx = function(t) return t.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0) end,
    blow = function(t) return t.CFrame * CFrame.new(0, -1.2, -1.5) * CFrame.Angles(math.rad(70), 0, 0) end,
    doggy = function(t) return t.CFrame * CFrame.new(0, -2.2, 1) * CFrame.Angles(math.rad(-80), 0, 0) end,
    hug = function(t) return t.CFrame * CFrame.new(0, 0, -1.2) end,
    tank = function(t) return t.CFrame * CFrame.new(0, -1, 2) * CFrame.Angles(0, 0, math.rad(90)) end,
}

local function startPose(name, target)
    target = target or resolvePlayer()
    if not target then return end
    if PoseActive == name and TargetPlayer == target then
        stopAll()
        return
    end
    stopAll()
    PoseActive = name
    CurrentAction = "pose"
    TargetPlayer = target
    local fn = PoseOffsets[name]
    if not fn then return end
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "pose" then return end
        local tr = getRoot(TargetPlayer)
        if not tr or not Root then return end
        if WeldEnabled then startGlue(tr) end
        Root.CFrame = fn(tr)
        Root.AssemblyLinearVelocity = Vector3.zero
    end)
end

-- ========== FORMATIONS ==========
local function formationCF(kind, targetRoot, slot)
    local a = ((slot - 1) / math.max(MaxBots, 1)) * math.pi * 2
    if kind == "rline" then
        return targetRoot.CFrame * CFrame.new(3 + slot * 2, 0, 0)
    elseif kind == "lline" then
        return targetRoot.CFrame * CFrame.new(-(3 + slot * 2), 0, 0)
    elseif kind == "bline" then
        return targetRoot.CFrame * CFrame.new(0, 0, 3 + slot * 2.5)
    elseif kind == "circle" then
        local r = 8
        return CFrame.new(targetRoot.Position) * CFrame.Angles(0, a, 0) * CFrame.new(0, 1, r)
    elseif kind == "stackon" then
        return targetRoot.CFrame * CFrame.new(0, slot * 3.2, 0)
    elseif kind == "elevator" then
        return targetRoot.CFrame * CFrame.new(0, -3 - (slot - 1) * 2.5, 0)
    elseif kind == "worm" then
        return targetRoot.CFrame * CFrame.new(0, 0, 3 + slot * 3)
    elseif kind == "swarm" then
        local r = 6 + (slot % 5)
        return CFrame.new(targetRoot.Position + Vector3.new(math.cos(a + tick()) * r, 2 + (slot % 3), math.sin(a + tick()) * r))
    elseif kind == "swarm2" then
        local r = 8
        local y = math.sin(a * 2 + tick()) * 5
        return CFrame.new(targetRoot.Position + Vector3.new(math.cos(a) * r, 3 + y, math.sin(a) * r))
    end
    return targetRoot.CFrame * CFrame.new(0, 2, 4)
end

local function startFormation(kind, targetName)
    local target = resolvePlayer(targetName)
    if not target then return end
    stopAll()
    CurrentAction = "formation"
    FormationType = kind
    TargetPlayer = target
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "formation" then return end
        local tr = getRoot(TargetPlayer)
        if not tr or not Root then return end
        local cf = formationCF(kind, tr, MySlot)
        if WeldEnabled then startGlue(tr) end
        Root.CFrame = cf
        Root.AssemblyLinearVelocity = Vector3.zero
    end)
end

-- ========== ORBIT / SPIRAL / HELI ==========
local function startOrbit(mode, targetName)
    local target = resolvePlayer(targetName)
    if not target then return end
    stopAll()
    CurrentAction = mode
    TargetPlayer = target
    OrbitAngle = (MySlot / MaxBots) * math.pi * 2
    FollowConn = RunService.Heartbeat:Connect(function(dt)
        if CurrentAction ~= mode then return end
        local tr = getRoot(TargetPlayer)
        if not tr or not Root then return end
        OrbitAngle = OrbitAngle + (OrbitSpeed * 0.05)
        local r = OrbitRadius
        local x, y, z = math.cos(OrbitAngle) * r, 2, math.sin(OrbitAngle) * r
        if mode == "orbit2" then
            y = math.sin(OrbitAngle) * r * 0.5
            x = math.cos(OrbitAngle) * r
            z = math.cos(OrbitAngle * 0.5) * r
        elseif mode == "orbit3" then
            y = 2 + math.sin(OrbitAngle * 3 + MySlot) * 4
            r = OrbitRadius * (0.6 + 0.4 * math.sin(OrbitAngle + MySlot))
            x, z = math.cos(OrbitAngle) * r, math.sin(OrbitAngle) * r
        elseif mode == "spiral" then
            y = (OrbitAngle % 20) - 5
            r = SpiralRadius
            x, z = math.cos(OrbitAngle * SpiralSpeed / OrbitSpeed) * r, math.sin(OrbitAngle * SpiralSpeed / OrbitSpeed) * r
        elseif mode == "spiral2" then
            y = 2
            r = SpiralRadius + math.sin(OrbitAngle) * 3
            x, z = math.cos(OrbitAngle) * r, math.sin(OrbitAngle) * r
        elseif mode == "helicopter" then
            local blade = OrbitAngle * HeliSpeed
            r = HeliRadius
            x = math.cos(blade + MySlot) * r
            z = math.sin(blade + MySlot) * r
            y = 5
        end
        Root.CFrame = CFrame.new(tr.Position + Vector3.new(x, y, z), tr.Position)
        Root.AssemblyLinearVelocity = Vector3.zero
    end)
end

