    hum.PlatformStand = true
    hum.AutoRotate = false
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyBV.P = 1e4
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyBG.P = 9e4
    flyBG.D = 1000
    flyBG.CFrame = workspace.CurrentCamera.CFrame
    flyBG.Parent = root
    if flyConn then flyConn:Disconnect() end
    flyConn = RunService.RenderStepped:Connect(function(dt)
        local charNow = localPlayer.Character
        local rootNow = charNow and charNow:FindFirstChild("HumanoidRootPart")
        local humNow = charNow and charNow:FindFirstChildOfClass("Humanoid")
        if not (rootNow and humNow and flyBV and flyBG and flyBV.Parent and flyBG.Parent) then
            flyHardStop()
            return
        end
        local cam = workspace.CurrentCamera
        if not cam or not cam.CFrame then return end
        if flyDisabling then
            local _, yaw, _ = flyBG.CFrame:ToOrientation()
            local upright = CFrame.new(rootNow.Position) * CFrame.Angles(0, yaw, 0)
            flyBG.CFrame = flyBG.CFrame:Lerp(upright, math.clamp(dt * FLY_DISABLE_SMOOTH, 0, 1))
            flyVel = flyVel:Lerp(Vector3.zero, math.clamp(dt * FLY_DISABLE_SMOOTH, 0, 1))
            flyBV.Velocity = flyVel
            if flyVel.Magnitude < 2 then
                flyHardStop()
            end
            return
        end
        flyBG.CFrame = flyBG.CFrame:Lerp(cam.CFrame, math.clamp(dt * FLY_ROT_SMOOTH, 0, 1))
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        if dir.Magnitude < 0.1 and humNow.MoveDirection.Magnitude > 0.1 then
            dir = dir + cam.CFrame:VectorToWorldSpace(Vector3.new(humNow.MoveDirection.X, 0, -humNow.MoveDirection.Z))
        end
        local curSpeed = UIS:IsKeyDown(Enum.KeyCode.LeftShift) and flySpeedVal * FLY_SPRINT_MULT or flySpeedVal
        local targetVel = dir.Magnitude > 0 and dir.Unit * curSpeed or Vector3.zero
        flyVel = flyVel:Lerp(targetVel, math.clamp(dt * FLY_SMOOTHNESS, 0, 1))
        flyBV.Velocity = flyVel
    end)
    print("[STAND-FLY] smooth fly ON (" .. tostring(flySpeedVal) .. " speed)")
end
