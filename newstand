local function walkTo(targetName)
    local target = resolvePlayer(targetName)
    if not target then return end
    stopAll()
    CurrentAction = "walkto"
    TargetPlayer = target
    pcall(function()
        Humanoid:MoveTo(getRoot(target).Position)
    end)
    FollowConn = RunService.Heartbeat:Connect(function()
        if CurrentAction ~= "walkto" then return end
        local tr = getRoot(TargetPlayer)
        if tr and Humanoid then Humanoid:MoveTo(tr.Position) end
    end)
end

local function pathfindTo(targetName)
    -- same as walkto with MoveTo (no PathfindingService dependency required)
    walkTo(targetName)
    CurrentAction = "pf"
end

